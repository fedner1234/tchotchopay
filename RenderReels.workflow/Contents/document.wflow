					<key>COMMAND_STRING</key>
					<string>export PATH="/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:$PATH"
cd "$HOME/Claude/Projects/tchotchopay"
echo "Installing packages..."
python3 -m pip install pycairo imageio-ffmpeg numpy --break-system-packages 2&gt;&amp;1 || python3 -m pip install pycairo imageio-ffmpeg numpy 2&gt;&amp;1 || true
if ! find ~/Library/Fonts /Library/Fonts /System/Library/Fonts -name "*Poppins*" 2&gt;/dev/null | grep -q .; then
  sed -i '' 's/"Poppins"/"Helvetica Neue"/g' render_all_reels.py 2&gt;/dev/null || true
fi
echo "Rendering..."
python3 render_all_reels.py
echo "All 4 reels done!"`	</string>
