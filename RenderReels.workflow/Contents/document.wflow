cd "$HOME/Claude/Projects/tchotchopay"
echo "Installing packages..."
python3 -m pip install pycairo imageio-ffmpeg numpy --break-system-packages 2&gt;&amp;1 || python3 -m pip install pycairo imageio-ffmpeg numpy 2&gt;&amp;1 || true
