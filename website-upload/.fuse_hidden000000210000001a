<script>
// ── STATE ──
let amtStr = '0';
let selName = 'Marie J.';
let selHandle = '@marie.haiti';

// ── NAVIGATION ──
const screens = ['home','send','receive','market','cashout','history','profile'];
function go(id) {
  screens.forEach(s => {
    document.getElementById('s-'+s).classList.toggle('on', s===id);
  });
  document.querySelectorAll('.tab').forEach((t,i) => {
    t.classList.toggle('on', screens[i]===id);
  });
  if (id === 'send') resetSend();
}

// ── SEND FLOW ──
function resetSend() {
  ['ss1','ss2','ss3','ss-done'].forEach((id,i) => {
    const el = document.getElementById(id);
    if(el) el.style.display = i===0 ? '' : 'none';
  });
  amtStr = '0';
  updateAmtDisplay();
}
function goStep(n) {
  document.getElementById('ss1').style.display = n===1 ? '' : 'none';
  document.getElementById('ss2').style.display = n===2 ? 'flex' : 'none';
  document.getElementById('ss3').style.display = n===3 ? 'flex' : 'none';
  document.getElementById('ss-done').style.display = 'none';
  if (n===2) { document.getElementById('recv-name').textContent = selName; }
  if (n===3) {
    const v = parseFloat(amtStr) || 0;
    if (v <= 0) { goStep(2); return; }
    document.getElementById('cf-to').textContent = selName;
    document.getElementById('cf-handle').textContent = selHandle;
    document.getElementById('cf-amt').textContent = '$' + v.toFixed(2);
    document.getElementById('cf-total').textContent = '$' + v.toFixed(2);
  }
}
function pickContact(el, name, handle) {
  document.querySelectorAll('.contact').forEach(c => c.classList.remove('sel'));
  el.classList.add('sel');
  selName = name; selHandle = handle;
}
function tap(d) {
  if (d==='.' && amtStr.includes('.')) return;
  if (amtStr.length > 8) return;
  if (amtStr==='0' && d!=='.') amtStr = d; else amtStr += d;
  updateAmtDisplay();
}
function del() {
  amtStr = amtStr.length > 1 ? amtStr.slice(0,-1) : '0';
  updateAmtDisplay();
}
function updateAmtDisplay() {
  const v = parseFloat(amtStr) || 0;
  document.getElementById('amt-val').textContent = amtStr;
  document.getElementById('amt-usdc').textContent = v.toFixed(2);
}
function goSendDone() {
  const v = parseFloat(amtStr) || 0;
  document.getElementById('ss3').style.display = 'none';
  document.getElementById('ss-done').style.display = '';
  document.getElementById('ss-done-msg').innerHTML =
    '<strong style="color:#fff;font-size:16px">$' + v.toFixed(2) + '</strong> sent to ' + selName + '<br><span style="color:rgba(255,255,255,0.5)">Arrived instantly on Base Network</span>';
}

// ── CASH OUT ──
function selCO(el) {
  document.querySelectorAll('.co-opt').forEach(o => o.classList.remove('sel'));
  el.classList.add('sel');
}
function updateCO(v) {
  document.getElementById('co-val').textContent = '$' + parseFloat(v).toFixed(2);
  document.getElementById('co-btn').innerHTML = '<i class="ti ti-cash"></i> Withdraw $' + parseFloat(v).toFixed(2);
  document.getElementById('htg-rate').textContent = (parseFloat(v) * 130.5).toFixed(0) + ' HTG';
}

// ── HISTORY FILTER TABS ──
document.querySelectorAll('.hf-btn').forEach(btn => {
  btn.addEventListener('click', function() {
    document.querySelectorAll('.hf-btn').forEach(b => b.classList.remove('on'));
    this.classList.add('on');
  });
});
</script>
