<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8"/>
<meta name="viewport" content="width=device-width,initial-scale=1.0"/>
<title>Tchotcho Pay — App Preview</title>
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@latest/tabler-icons.min.css"/>
<style>
*{box-sizing:border-box;margin:0;padding:0}
body{font-family:'Segoe UI',system-ui,sans-serif;background:#0a0f1e;min-height:100vh;padding:32px 16px 48px;display:flex;flex-direction:column;align-items:center}

/* ── PAGE HEADER ── */
.page-header{text-align:center;margin-bottom:28px}
.page-header h1{color:#fff;font-size:1.5rem;font-weight:800;letter-spacing:-0.02em}
.page-header h1 em{color:#00AEEF;font-style:normal}
.page-header p{color:#8FA8CC;font-size:0.88rem;margin-top:6px}

/* ── NAV TABS ── */
.tabs{display:flex;gap:6px;margin-bottom:24px;background:rgba(255,255,255,0.06);border:1px solid rgba(0,174,239,0.2);border-radius:50px;padding:4px;flex-wrap:wrap;justify-content:center}
.tab{border:none;background:none;padding:8px 16px;border-radius:50px;font-size:12px;font-weight:600;cursor:pointer;color:rgba(255,255,255,0.45);font-family:inherit;white-space:nowrap;transition:all 0.2s;display:flex;align-items:center;gap:5px}
.tab.on{background:#0A1F6E;color:#fff;box-shadow:0 0 16px rgba(0,174,239,0.3)}
.tab i{font-size:14px}

/* ── PHONE SHELL ── */
.phone{width:300px;background:#020B2D;border-radius:40px;overflow:hidden;border:7px solid #0d1020;box-shadow:0 32px 80px rgba(0,0,0,0.7),0 0 0 1px rgba(0,174,239,0.1)}
.statusbar{display:flex;justify-content:space-between;align-items:center;padding:12px 22px 4px;color:rgba(255,255,255,0.45);font-size:11px;flex-shrink:0}

/* ── SCREENS ── */
.screen{display:none;flex-direction:column;min-height:600px;position:relative}
.screen.on{display:flex}

/* ── BOTTOM NAV ── */
.bnav{display:flex;justify-content:space-around;padding:10px 0 12px;border-top:0.5px solid rgba(255,255,255,0.08);flex-shrink:0;margin-top:auto}
.bni{display:flex;flex-direction:column;align-items:center;gap:3px;font-size:10px;color:rgba(255,255,255,0.3);cursor:pointer;padding:0 10px;transition:color 0.15s}
.bni.on{color:#00AEEF}
.bni i{font-size:22px}

/* ── HOME ── */
.ph-header{padding:16px 20px 10px;color:#fff}
.ph-title{font-size:19px;font-weight:800;margin-bottom:2px}
.ph-sub{font-size:12px;color:rgba(255,255,255,0.45)}
.ph-section{font-size:10px;font-weight:700;color:rgba(255,255,255,0.35);text-transform:uppercase;letter-spacing:0.1em;margin:0 20px 8px}
.wallet-card{margin:4px 16px 14px;border-radius:22px;padding:22px;background:linear-gradient(135deg,#0A1F6E,#1055CC);position:relative;overflow:hidden}
.wallet-card::after{content:'';position:absolute;top:-30px;right:-30px;width:120px;height:120px;border-radius:50%;background:rgba(0,174,239,0.12)}
.wc-label{font-size:10px;color:rgba(255,255,255,0.55);text-transform:uppercase;letter-spacing:0.08em;margin-bottom:4px}
.wc-balance{font-size:34px;font-weight:800;color:#fff;line-height:1}
.wc-usdc{font-size:13px;color:#00AEEF;font-weight:600;margin-top:5px}
.wc-row{display:flex;justify-content:space-between;margin-top:14px;font-size:11px;color:rgba(255,255,255,0.45)}
.actions{display:grid;grid-template-columns:repeat(4,1fr);gap:8px;padding:0 16px 14px}
.action{display:flex;flex-direction:column;align-items:center;gap:5px;cursor:pointer}
.action-icon{width:50px;height:50px;border-radius:15px;background:rgba(13,37,128,0.7);display:flex;align-items:center;justify-content:center;color:#00AEEF;font-size:22px;border:1px solid rgba(0,174,239,0.15);transition:background 0.15s}
.action:hover .action-icon{background:rgba(0,174,239,0.2)}
.action-label{font-size:10px;color:rgba(255,255,255,0.5);font-weight:500}
.tx-list{padding:0 16px 14px;display:flex;flex-direction:column;gap:8px}
.tx{display:flex;align-items:center;gap:10px;padding:10px 12px;background:rgba(255,255,255,0.05);border-radius:12px;cursor:pointer;transition:background 0.15s}
.tx:hover{background:rgba(255,255,255,0.09)}
.tx-avatar{width:38px;height:38px;border-radius:50%;background:#0D2580;display:flex;align-items:center;justify-content:center;color:#00AEEF;font-size:17px;flex-shrink:0}
.tx-info{flex:1}
.tx-name{font-size:13px;font-weight:600;color:#fff}
.tx-desc{font-size:11px;color:rgba(255,255,255,0.4);margin-top:1px}
.tx-amt{font-size:13px;font-weight:700}
.tx-amt.pos{color:#00C896}
.tx-amt.neg{color:rgba(255,255,255,0.65)}

/* ── SEND ── */
.send-header{display:flex;align-items:center;gap:10px;padding:14px 16px 10px;flex-shrink:0}
.back-btn{width:34px;height:34px;border-radius:50%;background:rgba(255,255,255,0.08);display:flex;align-items:center;justify-content:center;color:#fff;cursor:pointer;font-size:17px;border:none;flex-shrink:0;transition:background 0.15s}
.back-btn:hover{background:rgba(255,255,255,0.15)}
.send-title{font-size:17px;font-weight:700;color:#fff}
.send-step{font-size:11px;color:#00AEEF;font-weight:600;margin-left:auto;background:rgba(0,174,239,0.12);padding:3px 10px;border-radius:50px}
.contact-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:10px;padding:4px 16px 16px}
.contact{display:flex;flex-direction:column;align-items:center;gap:6px;cursor:pointer;padding:10px 6px;border-radius:14px;border:1.5px solid transparent;transition:all 0.15s}
.contact.sel{border-color:#00AEEF;background:rgba(0,174,239,0.08)}
.contact:hover{background:rgba(255,255,255,0.05)}
.c-avatar{width:46px;height:46px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:15px;font-weight:700;color:#fff}
.c-name{font-size:11px;color:rgba(255,255,255,0.7);text-align:center;font-weight:600}
.c-addr{font-size:10px;color:rgba(255,255,255,0.35);text-align:center}
.amt-display{text-align:center;padding:16px 16px 10px;color:#fff}
.amt-big{font-size:48px;font-weight:800;color:#fff;line-height:1}
.amt-usdc{font-size:14px;color:#00AEEF;font-weight:600;margin-top:6px}
.numpad{display:grid;grid-template-columns:repeat(3,1fr);gap:1px;background:rgba(255,255,255,0.06);margin:0 16px;border-radius:16px;overflow:hidden}
.key{padding:15px;text-align:center;font-size:20px;font-weight:600;color:#fff;cursor:pointer;background:#020B2D;transition:background 0.1s;user-select:none}
.key:active{background:rgba(0,174,239,0.18)}
.key.del{color:#00AEEF}
.ph-btn{margin:10px 16px 0;padding:14px;border-radius:50px;border:none;font-size:14px;font-weight:700;cursor:pointer;width:calc(100% - 32px);font-family:inherit;transition:all 0.15s;display:flex;align-items:center;justify-content:center;gap:8px}
.ph-btn.primary{background:linear-gradient(135deg,#1055CC,#00AEEF);color:#fff}
.ph-btn.primary:hover{opacity:0.88}
.ph-btn.green{background:linear-gradient(135deg,#16a34a,#00C896);color:#fff}
.ph-btn.outline{background:transparent;color:#fff;border:1px solid rgba(255,255,255,0.2)}
.ph-btn.outline:hover{background:rgba(255,255,255,0.06)}
.confirm-box{margin:8px 16px;background:rgba(255,255,255,0.05);border-radius:16px;padding:14px}
.cf-row{display:flex;justify-content:space-between;align-items:center;padding:8px 0;border-bottom:0.5px solid rgba(255,255,255,0.06);font-size:13px}
.cf-row:last-child{border-bottom:none}
.cf-label{color:rgba(255,255,255,0.45)}
.cf-val{color:#fff;font-weight:600}
.cf-val.cyan{color:#00AEEF}
.cf-val.green{color:#00C896}
.success-screen{flex:1;display:flex;flex-direction:column;align-items:center;justify-content:center;padding:32px 24px;text-align:center}
.success-icon{width:80px;height:80px;border-radius:50%;background:linear-gradient(135deg,#16a34a,#00C896);display:flex;align-items:center;justify-content:center;font-size:36px;color:#fff;margin-bottom:20px;box-shadow:0 0 32px rgba(34,212,94,0.4)}
.success-title{font-size:24px;font-weight:800;color:#fff;margin-bottom:8px}
.success-sub{font-size:13px;color:rgba(255,255,255,0.5);line-height:1.7}

/* ── RECEIVE / QR ── */
.qr-box{margin:10px 16px;background:rgba(255,255,255,0.97);border-radius:20px;padding:20px;display:flex;flex-direction:column;align-items:center;gap:10px}
.qr-svg{width:160px;height:160px}
.qr-user{font-size:14px;font-weight:700;color:#020B2D}
.qr-addr{font-size:11px;color:#666;text-align:center}
.share-row{display:flex;gap:8px;padding:8px 16px;flex-wrap:wrap}
.share-btn{flex:1;background:rgba(255,255,255,0.08);border:1px solid rgba(255,255,255,0.15);border-radius:12px;padding:10px;font-size:12px;font-weight:600;color:#fff;cursor:pointer;display:flex;align-items:center;justify-content:center;gap:6px;font-family:inherit;white-space:nowrap;transition:background 0.15s}
.share-btn:hover{background:rgba(0,174,239,0.15);border-color:rgba(0,174,239,0.3)}
.receive-opts{display:flex;flex-direction:column;gap:8px;padding:4px 16px 12px}
.recv-opt{display:flex;align-items:center;gap:10px;padding:12px;background:rgba(255,255,255,0.05);border-radius:12px;font-size:13px;color:rgba(255,255,255,0.7)}
.recv-opt i{font-size:18px;color:#00AEEF;width:28px;flex-shrink:0}
.recv-opt strong{color:#fff;display:block;font-size:12px}

/* ── MARKETPLACE ── */
.search-bar{margin:4px 16px 10px;background:rgba(255,255,255,0.06);border-radius:10px;display:flex;align-items:center;gap:8px;padding:9px 12px;border:1px solid rgba(255,255,255,0.06);transition:border-color 0.2s;cursor:pointer}
.search-bar:hover{border-color:rgba(0,174,239,0.2)}
.search-bar i{font-size:16px;color:rgba(255,255,255,0.35)}
.search-bar span{font-size:13px;color:rgba(255,255,255,0.28)}
.cat-row{display:grid;grid-template-columns:repeat(3,1fr);gap:8px;padding:0 16px 12px}
.cat{display:flex;flex-direction:column;align-items:center;gap:5px;padding:12px 6px;background:rgba(255,255,255,0.05);border-radius:14px;cursor:pointer;transition:all 0.15s;border:1px solid transparent}
.cat:hover{background:rgba(0,174,239,0.1);border-color:rgba(0,174,239,0.2)}
.cat i{font-size:22px;color:#00AEEF}
.cat-name{font-size:10px;color:rgba(255,255,255,0.6);font-weight:500;text-align:center}
.merchant-list{display:flex;flex-direction:column;gap:8px;padding:0 16px 16px}
.merchant{display:flex;align-items:center;gap:10px;padding:11px 12px;background:rgba(255,255,255,0.05);border-radius:12px;cursor:pointer;transition:background 0.15s;border:1px solid transparent}
.merchant:hover{background:rgba(255,255,255,0.09);border-color:rgba(0,174,239,0.15)}
.m-icon{width:40px;height:40px;border-radius:11px;background:#0D2580;display:flex;align-items:center;justify-content:center;font-size:18px;flex-shrink:0}
.m-info{flex:1}
.m-name{font-size:13px;font-weight:600;color:#fff}
.m-desc{font-size:11px;color:rgba(255,255,255,0.4)}
.m-price{font-size:13px;font-weight:700;color:#00AEEF;white-space:nowrap}

/* ── CASH OUT ── */
.co-options{display:flex;flex-direction:column;gap:8px;padding:4px 16px 12px}
.co-opt{display:flex;align-items:center;gap:12px;padding:13px;background:rgba(255,255,255,0.05);border-radius:14px;cursor:pointer;border:1.5px solid transparent;transition:all 0.15s}
.co-opt.sel{border-color:#00AEEF;background:rgba(0,174,239,0.08)}
.co-opt:hover:not(.sel){background:rgba(255,255,255,0.08)}
.co-icon{width:42px;height:42px;border-radius:12px;background:#0D2580;display:flex;align-items:center;justify-content:center;font-size:20px;color:#00AEEF;flex-shrink:0}
.co-info{flex:1}
.co-name{font-size:13px;font-weight:600;color:#fff}
.co-desc{font-size:11px;color:rgba(255,255,255,0.4);margin-top:2px}
.co-tag{font-size:10px;font-weight:700;padding:3px 8px;border-radius:50px;background:rgba(0,174,239,0.15);color:#00AEEF;white-space:nowrap}
.amt-slider{padding:0 16px 12px}
.slider-label{display:flex;justify-content:space-between;font-size:12px;margin-bottom:8px}
.slider-label span{color:rgba(255,255,255,0.45)}
.slider-label strong{color:#00AEEF;font-size:15px}
input[type=range]{width:100%;accent-color:#00AEEF;height:4px}
.rate-info{margin:0 16px 8px;padding:10px 12px;background:rgba(0,174,239,0.08);border:0.5px solid rgba(0,174,239,0.25);border-radius:10px;display:flex;justify-content:space-between;align-items:center}
.rate-info span{font-size:12px;color:rgba(255,255,255,0.45)}
.rate-info strong{font-size:13px;color:#00C896;font-weight:700}

/* ── HISTORY ── */
.history-filter{display:flex;gap:6px;padding:4px 16px 12px;overflow-x:auto}
.hf-btn{background:rgba(255,255,255,0.06);border:none;border-radius:50px;padding:7px 14px;font-size:11px;font-weight:600;color:rgba(255,255,255,0.45);cursor:pointer;font-family:inherit;white-space:nowrap;transition:all 0.15s}
.hf-btn.on{background:#0A1F6E;color:#fff;border:1px solid rgba(0,174,239,0.3)}
.history-group{padding:0 16px 4px}
.hg-date{font-size:10px;font-weight:700;color:rgba(255,255,255,0.35);text-transform:uppercase;letter-spacing:0.08em;margin-bottom:8px}
.history-tx{display:flex;align-items:center;gap:10px;padding:10px 0;border-bottom:0.5px solid rgba(255,255,255,0.06)}
.history-tx:last-child{border-bottom:none}
.htx-icon{width:36px;height:36px;border-radius:50%;background:#0D2580;display:flex;align-items:center;justify-content:center;color:#00AEEF;font-size:16px;flex-shrink:0}
.htx-info{flex:1}
.htx-name{font-size:13px;font-weight:600;color:#fff}
.htx-desc{font-size:11px;color:rgba(255,255,255,0.4);margin-top:1px}
.htx-right{text-align:right}
.htx-amt{font-size:13px;font-weight:700}
.htx-status{font-size:10px;color:rgba(255,255,255,0.35);margin-top:2px}

/* ── PROFILE ── */
.profile-hero{display:flex;flex-direction:column;align-items:center;padding:16px 20px 20px}
.profile-avatar{width:70px;height:70px;border-radius:50%;background:linear-gradient(135deg,#0A1F6E,#00AEEF);display:flex;align-items:center;justify-content:center;font-size:26px;font-weight:700;color:#fff;margin-bottom:10px;position:relative}
.profile-badge{position:absolute;bottom:-2px;right:-2px;width:20px;height:20px;border-radius:50%;background:#00C896;border:2px solid #020B2D;display:flex;align-items:center;justify-content:center;font-size:10px;color:#fff}
.profile-name{font-size:17px;font-weight:800;color:#fff;margin-bottom:2px}
.profile-handle{font-size:12px;color:#00AEEF;margin-bottom:4px}
.profile-since{font-size:11px;color:rgba(255,255,255,0.35)}
.profile-stats{display:grid;grid-template-columns:repeat(3,1fr);gap:1px;background:rgba(255,255,255,0.06);border-radius:14px;margin:0 16px 16px;overflow:hidden}
.pstat{padding:12px 8px;text-align:center;background:#020B2D}
.pstat-num{font-size:16px;font-weight:800;color:#fff}
.pstat-label{font-size:10px;color:rgba(255,255,255,0.4);margin-top:2px}
.settings-list{display:flex;flex-direction:column;padding:0 16px;gap:2px}
.setting-item{display:flex;align-items:center;gap:12px;padding:12px 0;border-bottom:0.5px solid rgba(255,255,255,0.06);cursor:pointer}
.setting-item:last-child{border-bottom:none}
.setting-icon{width:34px;height:34px;border-radius:10px;background:rgba(13,37,128,0.7);display:flex;align-items:center;justify-content:center;color:#00AEEF;font-size:17px;flex-shrink:0}
.setting-info{flex:1}
.setting-name{font-size:13px;font-weight:600;color:#fff}
.setting-desc{font-size:11px;color:rgba(255,255,255,0.35);margin-top:1px}
.setting-arrow{color:rgba(255,255,255,0.3);font-size:16px}
.setting-toggle{width:36px;height:20px;background:#00C896;border-radius:50px;position:relative;cursor:pointer;flex-shrink:0}
.setting-toggle::after{content:'';position:absolute;right:3px;top:3px;width:14px;height:14px;border-radius:50%;background:#fff}
.logout-btn{margin:12px 16px 0;padding:13px;background:rgba(255,75,85,0.1);border:1px solid rgba(255,75,85,0.25);color:#FF4C6A;border-radius:50px;font-size:14px;font-weight:700;cursor:pointer;font-family:inherit;display:flex;align-items:center;justify-content:center;gap:8px;width:calc(100%-32px);transition:all 0.15s}
.logout-btn:hover{background:rgba(255,75,85,0.18)}
</style>
