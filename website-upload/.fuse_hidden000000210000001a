<body>

<div class="page-header">
  <h1>Tchotcho<em>Pay</em> — App Preview</h1>
  <p>Interactive mobile prototype · 6 screens · Click to explore</p>
</div>

<div class="tabs">
  <button class="tab on" onclick="go('home')"><i class="ti ti-home"></i> Wallet</button>
  <button class="tab" onclick="go('send')"><i class="ti ti-send"></i> Send</button>
  <button class="tab" onclick="go('receive')"><i class="ti ti-qrcode"></i> Receive</button>
  <button class="tab" onclick="go('market')"><i class="ti ti-shopping-cart"></i> Marketplace</button>
  <button class="tab" onclick="go('cashout')"><i class="ti ti-cash"></i> Cash Out</button>
  <button class="tab" onclick="go('history')"><i class="ti ti-clock"></i> History</button>
  <button class="tab" onclick="go('profile')"><i class="ti ti-user"></i> Profile</button>
</div>

<div class="phone">
  <div class="statusbar">
    <span>9:41</span>
    <span><i class="ti ti-wifi"></i>&nbsp;<i class="ti ti-battery-2"></i></span>
  </div>

  <!-- ═══ HOME ═══ -->
  <div class="screen on" id="s-home">
    <div class="ph-header">
      <div style="display:flex;justify-content:space-between;align-items:center">
        <div>
          <div style="font-size:12px;color:rgba(255,255,255,0.4)">Good morning,</div>
          <div class="ph-title">Marie J. 👋</div>
        </div>
        <div style="position:relative">
          <div style="width:42px;height:42px;border-radius:50%;background:#0D2580;display:flex;align-items:center;justify-content:center;color:#00AEEF;font-size:19px;cursor:pointer" onclick="go('profile')"><i class="ti ti-bell"></i></div>
          <div style="position:absolute;top:0;right:0;width:10px;height:10px;border-radius:50%;background:#FF4C6A;border:2px solid #020B2D"></div>
        </div>
      </div>
    </div>

    <div class="wallet-card">
      <div class="wc-label">Tchotcho Wallet</div>
      <div class="wc-balance">$250.00</div>
      <div class="wc-usdc">250.00 USDC · Base Network</div>
      <div class="wc-row">
        <span>@marie.haiti</span>
        <span style="color:#00C896">▲ +$100 today</span>
      </div>
    </div>

    <div class="actions">
      <div class="action" onclick="go('send')">
        <div class="action-icon"><i class="ti ti-send"></i></div>
        <div class="action-label">Send</div>
      </div>
      <div class="action" onclick="go('receive')">
        <div class="action-icon"><i class="ti ti-qrcode"></i></div>
        <div class="action-label">Receive</div>
      </div>
      <div class="action" onclick="go('market')">
        <div class="action-icon"><i class="ti ti-shopping-cart"></i></div>
        <div class="action-label">Shop</div>
      </div>
      <div class="action" onclick="go('cashout')">
        <div class="action-icon"><i class="ti ti-cash"></i></div>
        <div class="action-label">Cash Out</div>
      </div>
    </div>

    <!-- Mini chart bar -->
