<style>
  :root {
    --navy: #020B2D;
    --blue: #0A1F6E;
    --mid: #1055CC;
    --cyan: #00AEEF;
    --green: #00C896;
    --gold: #F7B731;
    --red: #FF4B4B;
    --white: #ffffff;
    --light: #f0f4ff;
    --muted: #8899BB;
  }

  * { margin: 0; padding: 0; box-sizing: border-box; }

  body {
    background: #0a0a1a;
    font-family: 'Segoe UI', system-ui, -apple-system, sans-serif;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: flex-start;
    padding: 20px;
  }

  /* ── Top bar ── */
  .top-bar {
    width: 100%;
    max-width: 1200px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 16px;
    padding: 0 4px;
  }
  .top-bar .brand {
    display: flex; align-items: center; gap: 10px;
    color: var(--white); font-size: 1.1rem; font-weight: 700;
  }
  .top-bar .brand span { color: var(--cyan); }
  .pos-badge {
    background: var(--green); color: var(--navy);
    font-size: 0.7rem; font-weight: 800; padding: 3px 8px;
    border-radius: 20px; letter-spacing: 1px;
  }
  .top-bar .back-link {
    color: var(--muted); text-decoration: none; font-size: 0.85rem;
    transition: color 0.2s;
  }
  .top-bar .back-link:hover { color: var(--cyan); }

  /* ── Tablet wrapper ── */
  .tablet {
    width: 100%;
    max-width: 1200px;
    min-height: 680px;
    background: var(--navy);
    border-radius: 24px;
    border: 3px solid #1a2a5a;
    box-shadow: 0 40px 120px rgba(0,174,239,0.15), 0 0 0 1px #0d1a3d;
    overflow: hidden;
    display: flex;
    flex-direction: column;
  }

  /* ── Tablet header ── */
  .tablet-header {
    background: var(--blue);
    padding: 12px 20px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    border-bottom: 1px solid rgba(255,255,255,0.08);
  }
  .tablet-header .merchant-info { display: flex; align-items: center; gap: 12px; }
  .merchant-avatar {
    width: 36px; height: 36px; border-radius: 50%;
    background: linear-gradient(135deg, var(--cyan), var(--mid));
    display: flex; align-items: center; justify-content: center;
    font-weight: 800; color: white; font-size: 0.9rem;
  }
  .merchant-name { color: white; font-weight: 600; font-size: 0.9rem; }
  .merchant-sub { color: var(--muted); font-size: 0.75rem; }
  .header-right { display: flex; align-items: center; gap: 16px; }
  .header-time { color: var(--muted); font-size: 0.8rem; }
  .wifi-icon { color: var(--green); font-size: 0.8rem; }
  .header-logo { color: var(--cyan); font-weight: 800; font-size: 1rem; }

  /* ── Main layout ── */
  .tablet-body {
    display: flex;
    flex: 1;
    overflow: hidden;
  }

  /* ── Sidebar ── */
  .sidebar {
    width: 80px;
    background: #050d2a;
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 16px 0;
    gap: 6px;
    border-right: 1px solid rgba(255,255,255,0.05);
  }
  .nav-item {
    width: 56px; height: 56px;
    border-radius: 14px;
    display: flex; flex-direction: column;
    align-items: center; justify-content: center;
    gap: 4px; cursor: pointer;
    transition: all 0.2s;
    color: var(--muted);
    border: 2px solid transparent;
  }
  .nav-item:hover { background: rgba(0,174,239,0.1); color: var(--cyan); }
  .nav-item.active {
    background: rgba(0,174,239,0.15);
    color: var(--cyan);
    border-color: rgba(0,174,239,0.3);
  }
  .nav-item .nav-icon { font-size: 1.2rem; }
  .nav-item .nav-label { font-size: 0.6rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.5px; }
  .sidebar-bottom { margin-top: auto; }

  /* ── Screens ── */
  .screen { display: none; flex: 1; overflow-y: auto; }
  .screen.active { display: flex; }

  /* ==============================
     SCREEN 1: DASHBOARD
  ============================== */
  #screen-dashboard {
    flex-direction: column;
    padding: 20px;
    gap: 16px;
    background: var(--navy);
  }
  .dash-greeting { color: white; font-size: 1.1rem; font-weight: 700; }
  .dash-date { color: var(--muted); font-size: 0.8rem; margin-top: 2px; }

  .stat-cards {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 12px;
  }
  .stat-card {
    background: var(--blue);
    border-radius: 14px;
    padding: 16px;
    border: 1px solid rgba(255,255,255,0.07);
  }
  .stat-label { color: var(--muted); font-size: 0.72rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.5px; margin-bottom: 8px; }
  .stat-value { color: white; font-size: 1.5rem; font-weight: 800; }
  .stat-value.green { color: var(--green); }
  .stat-value.cyan { color: var(--cyan); }
  .stat-value.gold { color: var(--gold); }
  .stat-sub { color: var(--muted); font-size: 0.72rem; margin-top: 4px; }

  .dash-grid { display: grid; grid-template-columns: 1.5fr 1fr; gap: 16px; }

  .dash-card {
    background: var(--blue);
    border-radius: 14px;
    padding: 16px;
    border: 1px solid rgba(255,255,255,0.07);
  }
  .dash-card-title {
    color: white; font-size: 0.85rem; font-weight: 700;
    margin-bottom: 14px; display: flex; align-items: center; gap: 8px;
  }

  .txn-list { display: flex; flex-direction: column; gap: 10px; }
  .txn-item {
    display: flex; align-items: center; gap: 12px;
    padding: 10px 12px;
    background: rgba(255,255,255,0.04);
    border-radius: 10px;
  }
  .txn-avatar {
    width: 32px; height: 32px; border-radius: 50%;
    display: flex; align-items: center; justify-content: center;
    font-size: 0.85rem; font-weight: 700; flex-shrink: 0;
  }
  .txn-avatar.moncash { background: rgba(255,75,75,0.2); color: #FF4B4B; }
  .txn-avatar.natcash { background: rgba(247,183,49,0.2); color: var(--gold); }
  .txn-avatar.cash { background: rgba(0,200,150,0.2); color: var(--green); }
  .txn-info { flex: 1; }
  .txn-name { color: white; font-size: 0.8rem; font-weight: 600; }
  .txn-method { color: var(--muted); font-size: 0.7rem; }
  .txn-amount { color: var(--green); font-size: 0.85rem; font-weight: 700; }
  .txn-time { color: var(--muted); font-size: 0.68rem; }

  .payment-breakdown { display: flex; flex-direction: column; gap: 10px; }
  .pay-method {
    display: flex; align-items: center; justify-content: space-between;
    padding: 10px 12px;
    background: rgba(255,255,255,0.04);
    border-radius: 10px;
  }
  .pay-method-left { display: flex; align-items: center; gap: 10px; }
  .pay-dot { width: 10px; height: 10px; border-radius: 50%; }
  .pay-name { color: white; font-size: 0.8rem; font-weight: 600; }
  .pay-count { color: var(--muted); font-size: 0.7rem; }
  .pay-amount { color: white; font-size: 0.82rem; font-weight: 700; }
  .pay-bar-wrap { height: 4px; background: rgba(255,255,255,0.06); border-radius: 4px; margin-top: 4px; }
  .pay-bar { height: 4px; border-radius: 4px; }

  /* ==============================
     SCREEN 2: NEW SALE / POS
  ============================== */
  #screen-sale {
    flex-direction: row;
    background: var(--navy);
  }

  .products-panel {
    flex: 1;
    padding: 20px;
    display: flex;
    flex-direction: column;
    gap: 14px;
    border-right: 1px solid rgba(255,255,255,0.06);
  }
  .products-header {
    display: flex; align-items: center; justify-content: space-between;
  }
  .products-title { color: white; font-size: 1rem; font-weight: 700; }
  .search-bar {
    background: var(--blue);
    border: 1px solid rgba(255,255,255,0.1);
    border-radius: 10px;
    padding: 8px 14px;
    color: white;
    font-size: 0.82rem;
    width: 180px;
    outline: none;
  }
  .search-bar::placeholder { color: var(--muted); }

  .cat-tabs { display: flex; gap: 8px; }
  .cat-tab {
    padding: 6px 14px; border-radius: 20px; font-size: 0.75rem;
    font-weight: 600; cursor: pointer; transition: all 0.2s;
    border: 1px solid rgba(255,255,255,0.1); color: var(--muted);
    background: transparent;
  }
  .cat-tab.active { background: var(--cyan); color: var(--navy); border-color: var(--cyan); }
  .cat-tab:hover:not(.active) { color: white; border-color: rgba(255,255,255,0.3); }

  .product-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 10px;
    overflow-y: auto;
    flex: 1;
  }
  .product-card {
    background: var(--blue);
    border-radius: 12px;
    padding: 14px;
    cursor: pointer;
    transition: all 0.2s;
    border: 2px solid transparent;
    display: flex; flex-direction: column; align-items: center;
    gap: 8px; text-align: center;
  }
  .product-card:hover { border-color: var(--cyan); transform: translateY(-2px); }
  .product-card:active { transform: scale(0.97); }
  .product-emoji { font-size: 2rem; }
  .product-name { color: white; font-size: 0.75rem; font-weight: 600; }
  .product-price { color: var(--green); font-size: 0.82rem; font-weight: 700; }

  /* Cart panel */
  .cart-panel {
    width: 300px;
    background: #050d2a;
    display: flex; flex-direction: column;
    padding: 20px;
    gap: 12px;
  }
  .cart-title { color: white; font-size: 1rem; font-weight: 700; }
  .cart-empty { color: var(--muted); font-size: 0.82rem; text-align: center; padding: 30px 0; }

  .cart-items { flex: 1; display: flex; flex-direction: column; gap: 8px; overflow-y: auto; }
  .cart-item {
    background: var(--blue);
    border-radius: 10px;
    padding: 10px 12px;
    display: flex; align-items: center; gap: 10px;
  }
  .cart-item-emoji { font-size: 1.2rem; }
  .cart-item-info { flex: 1; }
  .cart-item-name { color: white; font-size: 0.78rem; font-weight: 600; }
  .cart-item-price { color: var(--muted); font-size: 0.72rem; }
  .cart-qty {
    display: flex; align-items: center; gap: 6px;
  }
  .qty-btn {
    width: 22px; height: 22px; border-radius: 6px;
    background: rgba(255,255,255,0.1); border: none;
    color: white; font-size: 0.85rem; cursor: pointer;
    display: flex; align-items: center; justify-content: center;
    transition: background 0.2s;
  }
  .qty-btn:hover { background: var(--mid); }
  .qty-num { color: white; font-size: 0.82rem; font-weight: 700; min-width: 16px; text-align: center; }

  .cart-divider { height: 1px; background: rgba(255,255,255,0.06); }

  .cart-totals { display: flex; flex-direction: column; gap: 6px; }
  .cart-row { display: flex; justify-content: space-between; align-items: center; }
  .cart-row-label { color: var(--muted); font-size: 0.78rem; }
  .cart-row-value { color: white; font-size: 0.82rem; font-weight: 600; }
  .cart-total-row .cart-row-label { color: white; font-weight: 700; font-size: 0.9rem; }
  .cart-total-row .cart-row-value { color: var(--green); font-weight: 800; font-size: 1rem; }

  .pay-buttons { display: flex; flex-direction: column; gap: 8px; }
  .btn-moncash {
    background: linear-gradient(135deg, #FF4B4B, #CC0000);
    color: white; border: none; border-radius: 12px;
    padding: 12px; font-size: 0.85rem; font-weight: 700;
    cursor: pointer; transition: all 0.2s;
    display: flex; align-items: center; justify-content: center; gap: 8px;
  }
  .btn-natcash {
    background: linear-gradient(135deg, var(--gold), #e5a800);
    color: var(--navy); border: none; border-radius: 12px;
    padding: 12px; font-size: 0.85rem; font-weight: 700;
    cursor: pointer; transition: all 0.2s;
    display: flex; align-items: center; justify-content: center; gap: 8px;
  }
  .btn-moncash:hover { opacity: 0.9; transform: translateY(-1px); }
  .btn-natcash:hover { opacity: 0.9; transform: translateY(-1px); }
  .btn-tchotcho {
    background: linear-gradient(135deg, var(--mid), var(--cyan));
    color: white; border: none; border-radius: 12px;
    padding: 12px; font-size: 0.85rem; font-weight: 700;
    cursor: pointer; transition: all 0.2s;
    display: flex; align-items: center; justify-content: center; gap: 8px;
  }
  .btn-tchotcho:hover { opacity: 0.9; transform: translateY(-1px); }
  .btn-cash {
    background: rgba(0,200,150,0.15); color: var(--green);
    border: 1px solid rgba(0,200,150,0.3); border-radius: 12px;
    padding: 10px; font-size: 0.8rem; font-weight: 600;
    cursor: pointer; transition: all 0.2s;
  }
  .btn-cash:hover { background: rgba(0,200,150,0.25); }
  .btn-clear {
    background: transparent; color: var(--muted);
    border: 1px solid rgba(255,255,255,0.1); border-radius: 12px;
    padding: 8px; font-size: 0.78rem; cursor: pointer; transition: all 0.2s;
  }
  .btn-clear:hover { color: var(--red); border-color: var(--red); }

  /* ==============================
     SCREEN 3: PAYMENT QR
  ============================== */
  #screen-payment {
    align-items: center;
    justify-content: center;
    background: var(--navy);
    padding: 30px;
  }
  .payment-container {
    display: flex;
    gap: 40px;
    align-items: center;
    justify-content: center;
    width: 100%;
    max-width: 800px;
  }
  .payment-left { flex: 1; display: flex; flex-direction: column; gap: 20px; }
  .payment-method-badge {
    display: inline-flex; align-items: center; gap: 8px;
    padding: 8px 16px; border-radius: 20px;
    font-size: 0.85rem; font-weight: 700;
  }
  .payment-method-badge.moncash { background: rgba(255,75,75,0.15); color: #FF6B6B; border: 1px solid rgba(255,75,75,0.3); }
  .payment-method-badge.natcash { background: rgba(247,183,49,0.15); color: var(--gold); border: 1px solid rgba(247,183,49,0.3); }
  .payment-method-badge.tchotcho { background: rgba(0,174,239,0.15); color: var(--cyan); border: 1px solid rgba(0,174,239,0.3); }

  .payment-amount-display { color: white; }
  .payment-amount-htg { font-size: 2.5rem; font-weight: 800; color: var(--green); }
  .payment-amount-usd { font-size: 1rem; color: var(--muted); margin-top: 4px; }

  .payment-instructions { color: var(--muted); font-size: 0.85rem; line-height: 1.6; }
  .payment-steps { list-style: none; display: flex; flex-direction: column; gap: 10px; margin-top: 10px; }
  .payment-step {
    display: flex; align-items: flex-start; gap: 10px;
    color: rgba(255,255,255,0.7); font-size: 0.82rem;
  }
  .step-num {
    width: 22px; height: 22px; border-radius: 50%;
    background: var(--mid); color: white;
    display: flex; align-items: center; justify-content: center;
    font-size: 0.7rem; font-weight: 700; flex-shrink: 0; margin-top: 1px;
  }

  .payment-right { display: flex; flex-direction: column; align-items: center; gap: 16px; }
  .qr-frame {
    background: white;
    border-radius: 16px;
    padding: 16px;
    display: flex; align-items: center; justify-content: center;
    box-shadow: 0 0 40px rgba(0,174,239,0.3);
  }
  .qr-placeholder {
    width: 180px; height: 180px;
    display: grid; grid-template-columns: repeat(5,1fr); gap: 3px;
  }
  .qr-cell { border-radius: 2px; background: #1a1a2e; }
  .qr-cell.white { background: white; }

  .qr-label { color: var(--muted); font-size: 0.75rem; text-align: center; }
  .qr-amount-badge {
    background: var(--green); color: var(--navy);
    padding: 6px 16px; border-radius: 20px;
    font-size: 0.85rem; font-weight: 800;
  }

  .waiting-indicator {
    display: flex; align-items: center; gap: 8px;
    color: var(--cyan); font-size: 0.82rem;
  }
  .pulse-dot {
    width: 8px; height: 8px; border-radius: 50%;
    background: var(--cyan);
    animation: pulse 1.5s ease-in-out infinite;
  }
  @keyframes pulse {
    0%, 100% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.4; transform: scale(0.8); }
  }

  .btn-back-sale {
    background: rgba(255,255,255,0.06); color: var(--muted);
    border: 1px solid rgba(255,255,255,0.1); border-radius: 10px;
    padding: 10px 20px; font-size: 0.82rem; cursor: pointer;
    transition: all 0.2s; margin-top: 10px;
  }
  .btn-back-sale:hover { color: white; border-color: rgba(255,255,255,0.3); }

  .btn-simulate-pay {
    background: linear-gradient(135deg, var(--green), #00a87d);
    color: var(--navy); border: none; border-radius: 12px;
    padding: 12px 28px; font-size: 0.88rem; font-weight: 800;
    cursor: pointer; transition: all 0.2s;
  }
  .btn-simulate-pay:hover { transform: translateY(-2px); box-shadow: 0 6px 20px rgba(0,200,150,0.4); }

  /* ==============================
     SCREEN 4: RECEIPT / CONFIRMATION
  ============================== */
  #screen-receipt {
    align-items: center;
    justify-content: center;
    background: var(--navy);
    padding: 30px;
  }
  .receipt-container {
    background: var(--blue);
    border-radius: 20px;
    padding: 32px;
    width: 100%;
    max-width: 480px;
    border: 1px solid rgba(255,255,255,0.08);
    text-align: center;
  }
  .receipt-success-icon {
    width: 72px; height: 72px; border-radius: 50%;
    background: rgba(0,200,150,0.15);
    border: 3px solid var(--green);
    display: flex; align-items: center; justify-content: center;
    margin: 0 auto 16px;
    font-size: 2rem;
    animation: popIn 0.4s ease-out;
  }
  @keyframes popIn {
    0% { transform: scale(0.5); opacity: 0; }
    80% { transform: scale(1.1); }
    100% { transform: scale(1); opacity: 1; }
  }
  .receipt-title { color: var(--green); font-size: 1.4rem; font-weight: 800; margin-bottom: 4px; }
  .receipt-subtitle { color: var(--muted); font-size: 0.85rem; margin-bottom: 24px; }

  .receipt-body {
    background: rgba(0,0,0,0.2);
    border-radius: 12px;
    padding: 16px;
    text-align: left;
    margin-bottom: 20px;
  }
  .receipt-header-row {
    display: flex; justify-content: space-between;
    color: var(--muted); font-size: 0.72rem;
    text-transform: uppercase; letter-spacing: 0.5px;
    margin-bottom: 12px;
    padding-bottom: 8px;
    border-bottom: 1px solid rgba(255,255,255,0.06);
  }
  .receipt-line { display: flex; justify-content: space-between; padding: 5px 0; }
  .receipt-line-name { color: rgba(255,255,255,0.7); font-size: 0.8rem; }
  .receipt-line-val { color: white; font-size: 0.8rem; font-weight: 600; }
  .receipt-divider { height: 1px; background: rgba(255,255,255,0.06); margin: 10px 0; }
  .receipt-total-row { display: flex; justify-content: space-between; padding: 6px 0; }
  .receipt-total-label { color: white; font-size: 0.9rem; font-weight: 700; }
  .receipt-total-val { color: var(--green); font-size: 1rem; font-weight: 800; }

  .receipt-txn-id { color: var(--muted); font-size: 0.72rem; margin-top: 8px; text-align: center; }

  .receipt-wallet-badge {
    display: inline-flex; align-items: center; gap: 6px;
    padding: 6px 12px; border-radius: 8px; font-size: 0.78rem; font-weight: 700;
    margin-bottom: 20px;
  }
  .receipt-wallet-badge.moncash { background: rgba(255,75,75,0.15); color: #FF6B6B; }
  .receipt-wallet-badge.natcash { background: rgba(247,183,49,0.15); color: var(--gold); }

  .receipt-buttons { display: flex; gap: 10px; }
  .btn-new-sale {
    flex: 1; background: linear-gradient(135deg, var(--mid), var(--cyan));
    color: white; border: none; border-radius: 12px;
    padding: 12px; font-size: 0.85rem; font-weight: 700;
    cursor: pointer; transition: all 0.2s;
  }
  .btn-new-sale:hover { opacity: 0.9; }
  .btn-print {
    background: rgba(255,255,255,0.08); color: white;
    border: 1px solid rgba(255,255,255,0.1); border-radius: 12px;
    padding: 12px 20px; font-size: 0.85rem; cursor: pointer; transition: all 0.2s;
  }
  .btn-print:hover { background: rgba(255,255,255,0.15); }

  /* ==============================
     SCREEN 5: HISTORY
  ============================== */
  #screen-history {
    flex-direction: column;
    padding: 20px;
    gap: 16px;
    background: var(--navy);
  }
  .history-header { display: flex; align-items: center; justify-content: space-between; }
  .history-title { color: white; font-size: 1rem; font-weight: 700; }
  .history-filter {
