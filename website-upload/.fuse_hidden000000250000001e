  { id:12, emoji:'🧃', name:'Jus Mango', price:100, cat:'drink' },
  { id:13, emoji:'🍚', name:'Riz (5kg)', price:500, cat:'grocery' },
  { id:14, emoji:'🫘', name:'Pwa Wouj', price:350, cat:'grocery' },
  { id:15, emoji:'🫒', name:'Lwil Palim', price:400, cat:'grocery' },
  { id:16, emoji:'📱', name:'Top-up Digicel', price:500, cat:'service' },
];

// ── Cart state ──
let cart = {};
let currentPayMethod = 'moncash';

// ── Render products ──
function renderProducts(filter) {
  const grid = document.getElementById('product-grid');
  const filtered = filter ? products.filter(p => p.cat === filter) : products;
  grid.innerHTML = filtered.map(p => `
    <div class="product-card" onclick="addToCart(${p.id})">
      <div class="product-emoji">${p.emoji}</div>
      <div class="product-name">${p.name}</div>
      <div class="product-price">${p.price} HTG</div>
    </div>
  `).join('');
}
renderProducts();

function filterCat(btn, cat) {
  document.querySelectorAll('.cat-tab').forEach(b => b.classList.remove('active'));
  btn.classList.add('active');
  renderProducts(cat === 'all' ? null : cat);
}

// ── Cart logic ──
function addToCart(id) {
  const p = products.find(x => x.id === id);
  if (!p) return;
  cart[id] = cart[id] ? { ...cart[id], qty: cart[id].qty + 1 } : { ...p, qty: 1 };
  renderCart();
}

function changeQty(id, delta) {
  if (!cart[id]) return;
  cart[id].qty += delta;
  if (cart[id].qty <= 0) delete cart[id];
  renderCart();
}

function clearCart() {
  cart = {};
  renderCart();
}

function renderCart() {
  const items = Object.values(cart);
  const empty = document.getElementById('cart-empty');
  const cartDiv = document.getElementById('cart-items');

  if (items.length === 0) {
    empty.style.display = 'block';
    document.getElementById('subtotal').textContent = '0 HTG';
    document.getElementById('cart-total').textContent = '0 HTG';
    document.getElementById('cart-usd').textContent = '$0.00';
    return;
  }
  empty.style.display = 'none';

  let total = 0;
  const html = items.map(item => {
    total += item.price * item.qty;
    return `
      <div class="cart-item">
        <div class="cart-item-emoji">${item.emoji}</div>
        <div class="cart-item-info">
          <div class="cart-item-name">${item.name}</div>
          <div class="cart-item-price">${item.price} HTG each</div>
        </div>
        <div class="cart-qty">
          <button class="qty-btn" onclick="changeQty(${item.id},-1)">−</button>
          <span class="qty-num">${item.qty}</span>
          <button class="qty-btn" onclick="changeQty(${item.id},1)">+</button>
        </div>
      </div>
    `;
  }).join('');

  cartDiv.innerHTML = html + `<div id="cart-empty" style="display:none"></div>`;
  document.getElementById('subtotal').textContent = total.toLocaleString() + ' HTG';
  document.getElementById('cart-total').textContent = total.toLocaleString() + ' HTG';
  document.getElementById('cart-usd').textContent = '$' + (total / 130).toFixed(2);
}

// ── Payment flow ──
function payWith(method) {
  const items = Object.values(cart);
  if (items.length === 0) { alert('Add items first!'); return; }

  currentPayMethod = method;
  const total = items.reduce((s, i) => s + i.price * i.qty, 0);

  // Update payment screen
  const badge = document.getElementById('pay-badge');
  badge.textContent = method === 'moncash' ? '📱 MonCash' : method === 'natcash' ? '💛 NatCash' : '💎 TchotchoPay Wallet';
  badge.className = 'payment-method-badge ' + method;

  const usdAmount = (total/130).toFixed(2);
  document.getElementById('pay-htg').textContent = total.toLocaleString() + ' HTG';
  document.getElementById('pay-usd').textContent = method === 'tchotcho'
    ? '≈ ' + usdAmount + ' USDC (TchotchoPay Wallet)'
    : '≈ $' + usdAmount + ' USD';
  document.getElementById('qr-badge').textContent = method === 'tchotcho'
    ? usdAmount + ' USDC'
    : total.toLocaleString() + ' HTG';

  // Update steps for method
  const appName = method === 'moncash' ? 'MonCash' : method === 'natcash' ? 'NatCash' : 'TchotchoPay';
  const steps = method === 'tchotcho' ? `
    <li class="payment-step"><span class="step-num">1</span> Customer opens their <strong style="color:white">TchotchoPay</strong> app</li>
    <li class="payment-step"><span class="step-num">2</span> Tap <strong style="color:white">Pay</strong> → <strong style="color:white">Scan QR</strong></li>
    <li class="payment-step"><span class="step-num">3</span> Point camera at the QR code</li>
    <li class="payment-step"><span class="step-num">4</span> USDC deducted instantly from their wallet</li>
  ` : `
    <li class="payment-step"><span class="step-num">1</span> Open their <strong style="color:white">${appName}</strong> app on their phone</li>
    <li class="payment-step"><span class="step-num">2</span> Tap <strong style="color:white">Scan QR</strong> or <strong style="color:white">Pay Merchant</strong></li>
    <li class="payment-step"><span class="step-num">3</span> Point camera at the QR code</li>
    <li class="payment-step"><span class="step-num">4</span> Confirm amount and tap <strong style="color:white">Pay</strong></li>
  `;
  document.querySelector('.payment-steps').innerHTML = steps;

  drawQR(total, method);
  showScreen('payment', null);
}

// ── Draw fake QR ──
function drawQR(amount, method) {
  const canvas = document.getElementById('qr-canvas');
  const ctx = canvas.getContext('2d');
  const size = 180;
  const cellSize = size / 15;

  ctx.fillStyle = 'white';
  ctx.fillRect(0, 0, size, size);

  const color = method === 'moncash' ? '#CC0000' : '#e5a800';
  ctx.fillStyle = color;

  // Pseudo-random QR pattern
  const seed = amount + method.length;
  for (let r = 0; r < 15; r++) {
    for (let c = 0; c < 15; c++) {
      // Finder patterns
      if ((r < 3 && c < 3) || (r < 3 && c > 11) || (r > 11 && c < 3)) {
        ctx.fillRect(c * cellSize, r * cellSize, cellSize, cellSize);
        continue;
      }
      if ((r < 4 && c < 4) || (r < 4 && c > 10) || (r > 10 && c < 4)) continue;
      // Data
      const val = (r * 13 + c * 7 + seed) % 3;
      if (val > 0) ctx.fillRect(c * cellSize, r * cellSize, cellSize, cellSize);
    }
  }
  // Center logo
  ctx.fillStyle = 'white';
  ctx.fillRect(6*cellSize, 6*cellSize, 3*cellSize, 3*cellSize);
  ctx.fillStyle = color;
  ctx.fillRect(6.5*cellSize, 6.5*cellSize, 2*cellSize, 2*cellSize);
}

function simulatePayment() {
  const items = Object.values(cart);
  const total = items.reduce((s,i) => s + i.price * i.qty, 0);
  const method = currentPayMethod;

  // Populate receipt
  document.getElementById('receipt-badge').textContent =
    method === 'moncash' ? '📱 Paid via MonCash' :
    method === 'natcash' ? '💛 Paid via NatCash' :
    '💎 Paid via TchotchoPay Wallet';
  document.getElementById('receipt-badge').className =
    'receipt-wallet-badge ' + (method === 'tchotcho' ? 'moncash' : method);
  // Add USDC note on receipt if TchotchoPay
  if (method === 'tchotcho') {
    document.getElementById('receipt-badge').style.background = 'rgba(0,174,239,0.15)';
    document.getElementById('receipt-badge').style.color = 'var(--cyan)';
  } else {
    document.getElementById('receipt-badge').style.background = '';
    document.getElementById('receipt-badge').style.color = '';
  }

  document.getElementById('receipt-total').textContent = total.toLocaleString() + ' HTG';

  const now = new Date();
  document.getElementById('receipt-time').textContent =
    now.toLocaleTimeString('en-US', { hour:'2-digit', minute:'2-digit' });

  const txnId = 'TCP-2026-' + Math.random().toString(36).substr(2,8).toUpperCase();
  document.getElementById('receipt-txn').textContent = 'TXN ID: ' + txnId;

  document.getElementById('receipt-lines').innerHTML = items.map(item => `
    <div class="receipt-line">
      <span class="receipt-line-name">${item.emoji} ${item.name} ×${item.qty}</span>
      <span class="receipt-line-val">${(item.price * item.qty).toLocaleString()} HTG</span>
    </div>
  `).join('');

  showScreen('receipt', null);
}

function newSale() {
  clearCart();
  showScreen('sale', document.querySelectorAll('.nav-item')[1]);
}

// ── Screen navigation ──
function showScreen(name, navEl) {
  document.querySelectorAll('.screen').forEach(s => s.classList.remove('active'));
  document.querySelectorAll('.nav-item').forEach(n => n.classList.remove('active'));
  const target = document.getElementById('screen-' + name);
  if (target) target.classList.add('active');
  if (navEl) navEl.classList.add('active');
}

// ── Live time ──
function updateTime() {
  const now = new Date();
  document.getElementById('live-time').textContent =
    now.toLocaleTimeString('en-US', { hour:'2-digit', minute:'2-digit', second:'2-digit' });
  const opts = { weekday:'long', year:'numeric', month:'long', day:'numeric' };
  const dateEl = document.getElementById('dash-date');
  if (dateEl) dateEl.textContent = now.toLocaleDateString('en-US', opts);
}
updateTime();
setInterval(updateTime, 1000);
</script>
