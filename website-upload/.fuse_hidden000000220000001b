<style>
:root{
  --navy:#020B2D;--blue:#0A1F6E;--mid:#1055CC;--cyan:#00AEEF;--light:#7FD4F7;
  --white:#F0F6FF;--gray:#8FA8CC;--offwhite:#f0f6ff;--border:rgba(0,174,239,0.15);
  --card:rgba(255,255,255,0.04);
}
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0;}
html{scroll-behavior:smooth;}
body{font-family:'Segoe UI',system-ui,sans-serif;background:var(--navy);color:var(--white);line-height:1.6;overflow-x:hidden;}

/* NAV */
nav{position:fixed;top:0;left:0;right:0;z-index:999;display:flex;align-items:center;padding:14px 32px;background:rgba(2,11,45,.96);backdrop-filter:blur(12px);border-bottom:1px solid var(--border);gap:28px;}
.nav-logo{display:flex;align-items:center;gap:10px;text-decoration:none;color:var(--white);}
.nav-logo-box{width:34px;height:34px;background:linear-gradient(135deg,var(--blue),var(--cyan));border-radius:9px;overflow:hidden;}
.nav-logo-box img{width:100%;height:100%;object-fit:cover;}
.nav-brand{font-size:1.05rem;font-weight:700;}
.nav-brand em{color:var(--cyan);font-style:normal;}
.nav-links{display:flex;align-items:center;gap:20px;list-style:none;margin-left:auto;}
.nav-links a{color:var(--gray);text-decoration:none;font-size:.88rem;transition:color .2s;}
.nav-links a:hover{color:var(--white);}
.nav-cta{background:linear-gradient(135deg,var(--mid),var(--cyan));color:var(--white)!important;padding:8px 18px;border-radius:50px;font-weight:600;font-size:.85rem;}

/* HERO */
.help-hero{
  padding:120px 24px 60px;text-align:center;
  background:linear-gradient(180deg,rgba(2,11,45,1) 0%,rgba(10,31,110,.3) 100%);
  position:relative;overflow:hidden;
}
.help-hero::before{content:'';position:absolute;inset:0;background:radial-gradient(ellipse 60% 50% at 50% 30%,rgba(0,174,239,.12),transparent 70%);pointer-events:none;}
.help-badge{display:inline-flex;align-items:center;gap:7px;background:rgba(0,174,239,.1);border:1px solid rgba(0,174,239,.3);border-radius:50px;padding:5px 16px;font-size:.78rem;font-weight:700;color:var(--cyan);letter-spacing:.06em;text-transform:uppercase;margin-bottom:18px;}
.help-title{font-size:2.4rem;font-weight:900;margin-bottom:14px;line-height:1.15;}
.help-title em{color:var(--cyan);font-style:normal;}
.help-sub{font-size:1rem;color:var(--gray);max-width:500px;margin:0 auto 32px;}

/* SEARCH */
.search-wrap{max-width:520px;margin:0 auto;position:relative;}
.search-wrap input{
  width:100%;padding:16px 20px 16px 52px;border-radius:50px;
  background:rgba(255,255,255,.07);border:1.5px solid var(--border);
  color:var(--white);font-size:1rem;outline:none;font-family:inherit;transition:.2s;
}
.search-wrap input:focus{border-color:var(--cyan);background:rgba(255,255,255,.1);}
.search-wrap input::placeholder{color:var(--gray);}
.search-icon{position:absolute;left:18px;top:50%;transform:translateY(-50%);color:var(--gray);font-size:20px;pointer-events:none;}
.search-results{
  position:absolute;top:calc(100% + 8px);left:0;right:0;
  background:#0d1832;border:1px solid var(--border);border-radius:16px;
  overflow:hidden;display:none;z-index:10;
}
.search-results.show{display:block;}
.sr-item{padding:12px 18px;cursor:pointer;font-size:.9rem;border-bottom:1px solid var(--border);transition:.15s;display:flex;align-items:center;gap:10px;}
.sr-item:last-child{border-bottom:none;}
.sr-item:hover{background:rgba(0,174,239,.08);color:var(--cyan);}
.sr-item i{font-size:15px;color:var(--gray);}

/* QUICK LINKS */
.quick-links{max-width:900px;margin:0 auto;padding:0 24px 60px;display:grid;grid-template-columns:repeat(4,1fr);gap:14px;}
.ql-card{
  background:var(--card);border:1px solid var(--border);border-radius:14px;
  padding:20px 16px;text-align:center;cursor:pointer;text-decoration:none;
  color:var(--white);transition:.2s;
}
.ql-card:hover{border-color:rgba(0,174,239,.5);background:rgba(0,174,239,.07);transform:translateY(-2px);}
.ql-icon{font-size:28px;display:block;margin-bottom:10px;}
.ql-label{font-size:.85rem;font-weight:600;}
.ql-count{font-size:.75rem;color:var(--gray);margin-top:3px;}

/* MAIN LAYOUT */
.help-body{max-width:1000px;margin:0 auto;padding:0 24px 80px;display:grid;grid-template-columns:220px 1fr;gap:36px;align-items:start;}
.help-sidebar{position:sticky;top:80px;}
.help-sidebar ul{list-style:none;}
.help-sidebar ul li{margin-bottom:2px;}
.help-sidebar ul li a{display:flex;align-items:center;gap:8px;padding:8px 12px;border-radius:8px;text-decoration:none;font-size:.85rem;color:var(--gray);transition:.15s;border-left:2px solid transparent;}
.help-sidebar ul li a:hover{color:var(--white);background:rgba(255,255,255,.05);}
.help-sidebar ul li a.active{color:var(--cyan);background:rgba(0,174,239,.08);border-left-color:var(--cyan);}
.help-sidebar ul li a i{font-size:15px;}

/* SECTIONS */
.help-section{margin-bottom:52px;scroll-margin-top:90px;}
.section-header{display:flex;align-items:center;gap:12px;margin-bottom:22px;padding-bottom:14px;border-bottom:1px solid var(--border);}
.section-icon{width:40px;height:40px;border-radius:10px;display:flex;align-items:center;justify-content:center;font-size:20px;flex-shrink:0;}
.section-title{font-size:1.15rem;font-weight:800;}

/* FAQ ITEMS */
.faq-item{border:1px solid var(--border);border-radius:12px;margin-bottom:10px;overflow:hidden;transition:.2s;}
.faq-item:hover{border-color:rgba(0,174,239,.3);}
.faq-q{
  padding:16px 18px;cursor:pointer;display:flex;align-items:center;justify-content:space-between;
  font-size:.9rem;font-weight:600;user-select:none;gap:12px;
  background:var(--card);transition:background .15s;
}
.faq-q:hover{background:rgba(0,174,239,.05);}
.faq-q.open{color:var(--cyan);}
.faq-chevron{font-size:16px;color:var(--gray);transition:transform .25s;flex-shrink:0;}
.faq-q.open .faq-chevron{transform:rotate(180deg);color:var(--cyan);}
.faq-a{
  max-height:0;overflow:hidden;transition:max-height .35s ease,padding .25s;
  font-size:.88rem;color:var(--gray);line-height:1.75;
  background:rgba(0,174,239,.03);
}
.faq-a.open{max-height:800px;padding:14px 18px 18px;}
.faq-a a{color:var(--cyan);text-decoration:none;}
.faq-a a:hover{text-decoration:underline;}
.faq-a ul{margin:10px 0 0 18px;}
.faq-a ul li{margin-bottom:5px;}
.faq-a .note{
  margin-top:12px;padding:10px 14px;border-radius:8px;font-size:.82rem;
  background:rgba(0,174,239,.08);border:1px solid rgba(0,174,239,.2);color:var(--light);
  display:flex;align-items:flex-start;gap:8px;
}
.faq-a .note i{font-size:15px;flex-shrink:0;margin-top:1px;}
.faq-a .warn{background:rgba(255,215,64,.07);border-color:rgba(255,215,64,.2);color:#ffd740;}
.faq-a .warn i{color:#ffd740;}

/* CONTACT BAR */
.contact-bar{
  background:linear-gradient(135deg,rgba(16,85,204,.3),rgba(0,174,239,.15));
  border:1px solid rgba(0,174,239,.25);border-radius:16px;
  padding:28px 32px;text-align:center;margin-bottom:20px;
}
.contact-bar h3{font-size:1.1rem;font-weight:700;margin-bottom:6px;}
.contact-bar p{font-size:.88rem;color:var(--gray);margin-bottom:18px;}
.contact-buttons{display:flex;gap:10px;justify-content:center;flex-wrap:wrap;}
.contact-btn{display:inline-flex;align-items:center;gap:7px;padding:10px 20px;border-radius:50px;font-size:.85rem;font-weight:600;text-decoration:none;transition:.15s;}
.contact-btn-primary{background:linear-gradient(135deg,var(--mid),var(--cyan));color:#fff;}
.contact-btn-primary:hover{opacity:.88;}
.contact-btn-ghost{border:1.5px solid rgba(0,174,239,.4);color:var(--cyan);}
.contact-btn-ghost:hover{background:rgba(0,174,239,.08);}

/* FOOTER */
footer{background:#010818;border-top:1px solid rgba(0,174,239,.1);padding:36px 24px;}
.footer-inner{max-width:1000px;margin:0 auto;display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:18px;}
.footer-brand{display:flex;align-items:center;gap:10px;text-decoration:none;color:var(--white);}
.footer-links{display:flex;gap:20px;flex-wrap:wrap;}
.footer-links a{color:var(--gray);text-decoration:none;font-size:.85rem;transition:color .2s;}
.footer-links a:hover{color:var(--white);}
.footer-copy{color:var(--gray);font-size:.8rem;}

/* HIGHLIGHT */
.hl{background:rgba(0,174,239,.15);border-radius:3px;padding:1px 4px;color:var(--cyan);}

/* RESPONSIVE */
@media(max-width:760px){
  .nav-links{display:none;}
  .help-body{grid-template-columns:1fr;}
  .help-sidebar{display:none;}
  .quick-links{grid-template-columns:repeat(2,1fr);}
  .help-title{font-size:1.7rem;}
  nav{padding:12px 16px;}
}
