<script>
// ── ACCORDION ──
function toggle(btn) {
  const answer = btn.nextElementSibling;
  const isOpen = btn.classList.contains('open');
  // close all in same section
  const section = btn.closest('.help-section');
  section.querySelectorAll('.faq-q.open').forEach(q => {
    q.classList.remove('open');
    q.nextElementSibling.classList.remove('open');
    q.nextElementSibling.style.maxHeight = '';
  });
  if (!isOpen) {
    btn.classList.add('open');
    answer.classList.add('open');
  }
}

// ── SEARCH ──
const ALL_QA = [];
document.querySelectorAll('.faq-item').forEach(item => {
  const q = item.querySelector('.faq-q').textContent.trim().replace('keyboard_arrow_down','').trim();
  const a = item.querySelector('.faq-a').textContent.trim().substring(0, 120);
  const section = item.closest('.help-section').id;
  ALL_QA.push({ q, a, section, el: item });
});

function doSearch() {
  const val = document.getElementById('search-input').value.toLowerCase().trim();
  const box = document.getElementById('search-results');
  if (!val || val.length < 2) { box.classList.remove('show'); return; }
  const matches = ALL_QA.filter(qa => qa.q.toLowerCase().includes(val) || qa.a.toLowerCase().includes(val)).slice(0, 6);
  if (!matches.length) {
    box.innerHTML = '<div class="sr-item" style="color:var(--gray);cursor:default;"><i class="ti ti-search-off"></i> No results found for "'+val+'"</div>';
  } else {
    box.innerHTML = matches.map(m => `<div class="sr-item" onclick="jumpTo('${m.section}',this,'${m.q.substring(0,40)}')"><i class="ti ti-arrow-right"></i>${m.q}</div>`).join('');
  }
  box.classList.add('show');
}

function jumpTo(sectionId, el, q) {
  document.getElementById('search-results').classList.remove('show');
  document.getElementById('search-input').value = '';
  const section = document.getElementById(sectionId);
  section.scrollIntoView({ behavior: 'smooth', block: 'start' });
  // find and open the matching question
  setTimeout(() => {
    section.querySelectorAll('.faq-q').forEach(btn => {
      if (btn.textContent.trim().includes(q.substring(0, 30))) {
        if (!btn.classList.contains('open')) toggle(btn);
      }
    });
  }, 400);
}

document.addEventListener('click', e => {
  if (!e.target.closest('.search-wrap')) {
    document.getElementById('search-results').classList.remove('show');
  }
});

// ── SIDEBAR ACTIVE ──
const sections = document.querySelectorAll('.help-section');
const navLinks = document.querySelectorAll('.help-sidebar a');
window.addEventListener('scroll', () => {
  let current = '';
  sections.forEach(s => {
    if (window.scrollY >= s.offsetTop - 120) current = s.id;
  });
  navLinks.forEach(a => {
    a.classList.toggle('active', a.getAttribute('href') === '#' + current);
  });
});

function showChat() {
  alert('Live chat is coming soon! Email support@tchotchopay.com for now.');
}
</script>
