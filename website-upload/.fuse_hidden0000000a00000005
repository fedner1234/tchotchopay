  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    :root {
      --navy:   #020B2D;
      --blue:   #0A1F6E;
      --mid:    #1055CC;
      --cyan:   #00AEEF;
      --light:  #7FD4F7;
      --white:  #F0F6FF;
      --offwhite: #F0F6FF;
      --gray:   #8FA8CC;
      --card-bg: rgba(255,255,255,0.06);
      --card-border: rgba(0,174,239,0.25);
    }

    html { scroll-behavior: smooth; }

    body {
      font-family: 'Segoe UI', system-ui, -apple-system, sans-serif;
      background: var(--navy);
      color: var(--white);
      line-height: 1.6;
      overflow-x: hidden;
    }

    /* ── NAV ── */
    nav {
      position: fixed; top: 0; left: 0; right: 0; z-index: 9999;
      display: flex; align-items: center;
      padding: 14px 32px;
      background: rgba(2, 11, 45, 0.96);
      backdrop-filter: blur(12px);
      border-bottom: 1px solid rgba(0,174,239,0.2);
      gap: 32px;
    }

    .nav-brand {
      display: flex; align-items: center; gap: 10px;
      text-decoration: none; color: var(--white); flex-shrink: 0;
    }
    .nav-logo {
      width: 36px; height: 36px;
      background: linear-gradient(135deg, #0A1F6E, #00AEEF);
      border-radius: 9px; overflow: hidden;
    }
    .nav-logo img { width: 100%; height: 100%; object-fit: cover; }
    .nav-brand span { font-size: 1.15rem; font-weight: 700; }
    .nav-brand span em { color: var(--cyan); font-style: normal; }

    .nav-links {
      display: flex; align-items: center; gap: 24px; list-style: none;
      margin-left: auto;
    }
    .nav-links a { color: var(--gray); text-decoration: none; font-size: 0.88rem; white-space: nowrap; transition: color 0.2s; }
    .nav-links a:hover { color: var(--white); }
    .nav-cta {
      background: linear-gradient(135deg, var(--mid), var(--cyan));
      color: var(--white) !important; padding: 9px 20px; border-radius: 50px;
      font-weight: 600; font-size: 0.85rem;
    }

    /* hamburger */
    .hamburger {
      display: none; flex-direction: column; gap: 5px; cursor: pointer;
      background: none; border: none; margin-left: auto; padding: 4px;
    }
    .hamburger span {
      display: block; width: 24px; height: 2px;
      background: var(--white); border-radius: 2px;
      transition: transform 0.3s, opacity 0.3s;
    }
    .hamburger.open span:nth-child(1) { transform: translateY(7px) rotate(45deg); }
    .hamburger.open span:nth-child(2) { opacity: 0; }
    .hamburger.open span:nth-child(3) { transform: translateY(-7px) rotate(-45deg); }

    .mobile-menu {
      display: none; position: fixed; top: 64px; left: 0; right: 0;
      background: rgba(2,11,45,0.98); backdrop-filter: blur(16px);
      border-bottom: 1px solid rgba(0,174,239,0.2); z-index: 9998;
      flex-direction: column; padding: 20px 24px; gap: 16px;
    }
    .mobile-menu.open { display: flex; }
    .mobile-menu a { color: var(--gray); text-decoration: none; font-size: 1rem; padding: 8px 0; border-bottom: 1px solid rgba(255,255,255,0.06); }
    .mobile-menu a:last-child { border-bottom: none; color: var(--cyan); font-weight: 700; }

    /* lang switcher — lives inside nav, not fixed */
    .lang-switcher {
      display: flex; align-items: center; gap: 3px;
      background: #0A1F6E;
      border: 1.5px solid rgba(0,174,239,0.6);
      border-radius: 50px; padding: 3px;
      flex-shrink: 0; margin-left: 16px;
    }
    .lang-btn {
      background: none; border: none; cursor: pointer;
      color: #ffffff; font-size: 0.76rem; font-weight: 800;
      padding: 5px 10px; border-radius: 50px;
      font-family: inherit; letter-spacing: 0.05em;
      transition: background 0.18s;
    }
    .lang-btn.active { background: linear-gradient(135deg, #1055CC, #00AEEF); }
    .lang-btn:hover:not(.active) { background: rgba(255,255,255,0.15); }

    /* ── SCROLL REVEAL ── */
    .reveal {
      opacity: 0; transform: translateY(28px);
      transition: opacity 0.6s ease, transform 0.6s ease;
    }
    .reveal.visible { opacity: 1; transform: none; }
    .reveal-left { opacity: 0; transform: translateX(-30px); transition: opacity 0.6s ease, transform 0.6s ease; }
    .reveal-left.visible { opacity: 1; transform: none; }
    .reveal-right { opacity: 0; transform: translateX(30px); transition: opacity 0.6s ease, transform 0.6s ease; }
    .reveal-right.visible { opacity: 1; transform: none; }

    /* ── HERO ── */
    .hero {
      min-height: 100vh;
      display: flex; align-items: center; justify-content: center;
      text-align: center;
      padding: 120px 24px 80px;
      position: relative; overflow: hidden;
    }

    .hero-bg {
      position: absolute; inset: 0; z-index: 0;
      background:
        radial-gradient(ellipse 70% 60% at 50% 30%, rgba(0,174,239,0.18) 0%, transparent 70%),
        radial-gradient(ellipse 50% 40% at 80% 70%, rgba(16,85,204,0.25) 0%, transparent 60%),
        linear-gradient(180deg, #020B2D 0%, #040D30 100%);
    }
    .hero-bg::after {
      content: '';
      position: absolute; inset: 0;
      background-image:
        linear-gradient(rgba(0,174,239,0.05) 1px, transparent 1px),
        linear-gradient(90deg, rgba(0,174,239,0.05) 1px, transparent 1px);
      background-size: 60px 60px;
    }

    .hero-content { position: relative; z-index: 1; max-width: 820px; }

    .hero-badge {
      display: inline-flex; align-items: center; gap: 8px;
      background: rgba(0,174,239,0.12);
      border: 1px solid rgba(0,174,239,0.35);
      border-radius: 50px; padding: 6px 18px;
      font-size: 0.82rem; color: var(--cyan); font-weight: 600;
      letter-spacing: 0.06em; text-transform: uppercase; margin-bottom: 28px;
    }
    .hero-badge::before {
      content: ''; width: 7px; height: 7px; border-radius: 50%;
      background: var(--cyan); animation: pulse 2s infinite;
    }
    @keyframes pulse {
      0%,100% { opacity: 1; transform: scale(1); }
      50% { opacity: 0.4; transform: scale(1.4); }
    }

    .hero-logo-wrap {
      width: 120px; height: 120px; margin: 0 auto 32px;
      border-radius: 28px;
      background: linear-gradient(135deg, #0a1f6e 0%, #00aeef 100%);
      padding: 3px;
      box-shadow: 0 0 60px rgba(0,174,239,0.4);
      animation: floatLogo 4s ease-in-out infinite;
    }
    @keyframes floatLogo {
      0%,100% { transform: translateY(0); }
      50% { transform: translateY(-10px); }
    }
    .hero-logo-inner { width: 100%; height: 100%; border-radius: 26px; overflow: hidden; }
    .hero-logo-inner img { width: 100%; height: 100%; object-fit: cover; }

    .hero h1 {
      font-size: clamp(2.4rem, 5.5vw, 4rem);
      font-weight: 800; line-height: 1.1; letter-spacing: -0.03em; margin-bottom: 24px;
    }
    .hero h1 .accent { color: var(--cyan); }

    .hero p {
      font-size: 1.15rem; color: var(--gray); max-width: 600px;
      margin: 0 auto 40px; line-height: 1.7;
    }

    .hero-btns { display: flex; gap: 16px; justify-content: center; flex-wrap: wrap; }

    .btn-primary {
      display: inline-block; padding: 16px 36px; border-radius: 50px;
      background: linear-gradient(135deg, var(--mid) 0%, var(--cyan) 100%);
      color: var(--white); font-weight: 700; font-size: 1rem;
      text-decoration: none; letter-spacing: -0.01em;
      box-shadow: 0 8px 32px rgba(0,174,239,0.35);
      transition: transform 0.2s, box-shadow 0.2s;
    }
    .btn-primary:hover { transform: translateY(-2px); box-shadow: 0 12px 40px rgba(0,174,239,0.5); }

    .btn-secondary {
      display: inline-block; padding: 16px 36px; border-radius: 50px;
      border: 1.5px solid rgba(0,174,239,0.4);
      color: var(--cyan); font-weight: 600; font-size: 1rem;
      text-decoration: none; background: transparent;
      transition: background 0.2s, border-color 0.2s;
    }
    .btn-secondary:hover { background: rgba(0,174,239,0.1); border-color: var(--cyan); }

    .stats { display: flex; justify-content: center; gap: 48px; flex-wrap: wrap; margin-top: 64px; }
    .stat { text-align: center; }
    .stat-num { font-size: 2rem; font-weight: 800; color: var(--white); }
    .stat-num span { color: var(--cyan); }
    .stat-label { font-size: 0.8rem; color: var(--gray); text-transform: uppercase; letter-spacing: 0.06em; }

    /* ── SHARED ── */
    section { padding: 96px 24px; }
    .container { max-width: 1120px; margin: 0 auto; }
    .section-label {
      font-size: 0.78rem; font-weight: 700; letter-spacing: 0.1em;
      text-transform: uppercase; color: var(--cyan); margin-bottom: 12px;
    }
    .section-title {
      font-size: clamp(1.8rem, 3.5vw, 2.6rem);
      font-weight: 800; letter-spacing: -0.03em; line-height: 1.15; margin-bottom: 16px;
    }
    .section-sub { color: var(--gray); font-size: 1.05rem; max-width: 540px; }

    /* ── FEATURES ── */
    .features { background: linear-gradient(180deg, #020B2D 0%, #030F38 100%); }
    .features-grid {
      display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
      gap: 24px; margin-top: 56px;
    }
    .feature-card {
      background: var(--card-bg); border: 1px solid var(--card-border);
      border-radius: 20px; padding: 32px;
      transition: transform 0.25s, border-color 0.25s, box-shadow 0.25s;
    }
    .feature-card:hover {
      transform: translateY(-6px); border-color: rgba(0,174,239,0.5);
      box-shadow: 0 12px 40px rgba(0,174,239,0.18);
    }
    .feature-icon {
      width: 52px; height: 52px; border-radius: 14px;
      background: linear-gradient(135deg, rgba(16,85,204,0.5), rgba(0,174,239,0.4));
      display: flex; align-items: center; justify-content: center;
      font-size: 1.5rem; margin-bottom: 20px;
      border: 1px solid rgba(0,174,239,0.2);
    }
    .feature-card h3 { font-size: 1.1rem; font-weight: 700; margin-bottom: 10px; }
    .feature-card p { color: var(--gray); font-size: 0.93rem; line-height: 1.65; }

    /* ── HOW IT WORKS ── */
    .how-it-works { background: #030F38; }
    .hiw-header { max-width: 560px; }
    .steps { margin-top: 64px; display: flex; flex-direction: column; }
    .step {
      display: grid; grid-template-columns: 80px 1fr;
      gap: 32px; padding: 40px 0;
      border-bottom: 1px solid rgba(0,174,239,0.12); align-items: start;
    }
    .step:last-child { border-bottom: none; }
    .step-num-col { display: flex; flex-direction: column; align-items: center; }
    .step-num {
      width: 56px; height: 56px; border-radius: 50%;
      background: linear-gradient(135deg, var(--mid), var(--cyan));
      display: flex; align-items: center; justify-content: center;
      font-size: 1.15rem; font-weight: 800; color: var(--white);
      box-shadow: 0 0 24px rgba(0,174,239,0.4); flex-shrink: 0;
    }
    .step-connector {
      width: 2px; flex: 1; min-height: 60px;
      background: linear-gradient(180deg, rgba(0,174,239,0.4), rgba(0,174,239,0.05));
      margin-top: 10px;
    }
    .step:last-child .step-connector { display: none; }
    .step-body { padding-top: 12px; }
    .step-body h3 { font-size: 1.25rem; font-weight: 700; margin-bottom: 12px; }
    .step-body p { color: var(--gray); font-size: 0.97rem; margin-bottom: 16px; line-height: 1.7; }
    .step-tags { display: flex; flex-wrap: wrap; gap: 8px; }
    .tag {
      background: rgba(0,174,239,0.1); border: 1px solid rgba(0,174,239,0.25);
      border-radius: 50px; padding: 4px 14px; font-size: 0.8rem; color: var(--light);
    }
    .flow-example {
      margin-top: 20px; background: rgba(0,174,239,0.07);
      border: 1px solid rgba(0,174,239,0.2); border-radius: 14px; padding: 20px 24px;
      display: flex; align-items: center; gap: 12px; flex-wrap: wrap;
    }
    .flow-step {
      background: rgba(16,85,204,0.4); border-radius: 8px; padding: 8px 14px;
      font-size: 0.85rem; color: var(--white); font-weight: 600;
    }
    .flow-arrow { color: var(--cyan); font-size: 1.1rem; font-weight: 700; }

    /* ── APP PREVIEW SECTION ── */
    .app-preview { background: #030F38; padding: 96px 24px; }
    .app-preview-inner {
      display: grid; grid-template-columns: 1fr 1fr;
      gap: 80px; align-items: center; max-width: 1120px; margin: 0 auto;
    }
    .phone-showcase {
      display: flex; justify-content: center; gap: 16px;
      perspective: 1200px; flex-wrap: nowrap; overflow-x: auto;
      padding-bottom: 8px;
    }
    .phone-showcase::-webkit-scrollbar { height: 4px; }
    .phone-showcase::-webkit-scrollbar-thumb { background: rgba(0,174,239,0.3); border-radius: 4px; }
    .phone-frame {
      width: 200px; background: #020B2D;
      border-radius: 32px; overflow: hidden;
      border: 5px solid #0d1020;
      box-shadow: 0 32px 80px rgba(0,0,0,0.5), 0 0 0 1px rgba(0,174,239,0.15);
    }
    .phone-frame:first-child {
      transform: rotate(-6deg) translateY(20px);
      box-shadow: -8px 24px 60px rgba(0,0,0,0.5), 0 0 0 1px rgba(0,174,239,0.15);
    }
    .phone-frame:last-child {
      transform: rotate(6deg) translateY(20px);
      box-shadow: 8px 24px 60px rgba(0,0,0,0.5), 0 0 0 1px rgba(0,174,239,0.15);
    }

    /* ── iPHONE MOCKUP (large) ── */
    .iphone-showcase { display:flex; flex-direction:column; align-items:center; justify-content:center; }
    .iphone-wrap { position:relative; }
    .iphone-glow {
      position:absolute; bottom:-24px; left:50%; transform:translateX(-50%);
      width:200px; height:40px;
      background:rgba(0,174,239,.3); filter:blur(28px); border-radius:50%;
    }
    .iphone-shell {
      width:300px;
      background:linear-gradient(165deg,#1a1a2e,#0d0d1a);
      border-radius:54px;
      border:10px solid #1c1c2e;
      box-shadow:
        0 0 0 1px rgba(255,255,255,.08),
        inset 0 0 0 1px rgba(255,255,255,.04),
        0 40px 100px rgba(0,0,0,.7),
        0 0 60px rgba(0,174,239,.08);
      position:relative;
      overflow:hidden;
    }
    /* Side buttons */
    .iphone-btn-vol1,.iphone-btn-vol2,.iphone-btn-power {
      position:absolute; background:rgba(255,255,255,.12); border-radius:3px;
    }
    .iphone-btn-vol1 { left:-12px; top:110px; width:4px; height:36px; }
    .iphone-btn-vol2 { left:-12px; top:155px; width:4px; height:36px; }
    .iphone-btn-power { right:-12px; top:130px; width:4px; height:56px; }

    .iphone-screen {
      background:#070d1f; border-radius:44px; overflow:hidden;
      height:600px; position:relative; display:flex; flex-direction:column;
    }

    /* Status bar */
    .iph-status {
      display:flex; align-items:center; justify-content:space-between;
      padding:14px 20px 4px; flex-shrink:0; position:relative;
    }
    .iph-time { font-size:.8rem; font-weight:800; }
    .iph-notch {
      position:absolute; top:0; left:50%; transform:translateX(-50%);
      width:110px; height:32px; background:#000; border-radius:0 0 20px 20px;
    }
    .iph-status-right { display:flex; gap:5px; font-size:.72rem; }

    /* Screen container */
    .iph-screens { flex:1; position:relative; overflow:hidden; }
    .iph-screen {
      position:absolute; inset:0; padding:10px 18px 0;
      display:flex; flex-direction:column; gap:6px;
      opacity:0; transform:translateX(40px); transition:all .45s ease;
      pointer-events:none; overflow:hidden;
    }
    .iph-screen.active { opacity:1; transform:translateX(0); pointer-events:auto; }

    /* Home bar */
    .iphone-home-bar {
      height:28px; display:flex; align-items:center; justify-content:center;
      background:#070d1f; flex-shrink:0;
    }
    .iphone-home-bar::after {
      content:''; width:100px; height:5px;
      background:rgba(255,255,255,.25); border-radius:3px;
    }

    /* Screen internals */
    .iph-topbar { display:flex; align-items:center; justify-content:space-between; margin-bottom:4px; }
    .iph-greeting { font-size:.72rem; color:rgba(255,255,255,.4); }
    .iph-username { font-size:1rem; font-weight:800; }
    .iph-back { font-size:.78rem; color:rgba(0,174,239,.8); cursor:pointer; }
    .iph-avatar {
      width:36px; height:36px; border-radius:50%;
      background:linear-gradient(135deg,#1055CC,#00AEEF);
      display:flex; align-items:center; justify-content:center;
      font-size:.72rem; font-weight:800; flex-shrink:0;
    }
    .iph-balance-card {
      background:linear-gradient(135deg,rgba(10,31,110,.8),rgba(16,85,204,.4));
      border:1px solid rgba(0,174,239,.25); border-radius:20px; padding:16px;
    }
    .iph-bal-label { font-size:.68rem; color:rgba(255,255,255,.4); margin-bottom:3px; }
    .iph-bal-amount { font-size:1.8rem; font-weight:900; line-height:1.1; }
    .iph-bal-currency { font-size:.9rem; color:rgba(255,255,255,.4); }
    .iph-bal-htg { font-size:.68rem; color:rgba(255,255,255,.3); margin-bottom:12px; }
    .iph-bal-actions { display:flex; gap:8px; }
    .iph-act {
      flex:1; background:rgba(255,255,255,.07); border-radius:12px;
      padding:8px 4px; text-align:center; font-size:.6rem; color:rgba(255,255,255,.5);
      display:flex; flex-direction:column; gap:3px; align-items:center;
    }
    .iph-act span { display:block; }

    .iph-section-label {
      font-size:.68rem; color:rgba(0,174,239,.7); font-weight:700;
      text-transform:uppercase; letter-spacing:.07em; margin-top:2px;
    }
    .iph-tx {
      display:flex; align-items:center; gap:10px;
      padding:8px 0; border-bottom:1px solid rgba(255,255,255,.04);
    }
    .iph-tx:last-of-type { border:none; }
    .iph-tx-ico {
      width:34px; height:34px; border-radius:10px;
      display:flex; align-items:center; justify-content:center; font-size:.9rem; flex-shrink:0;
    }
    .iph-tx-info { flex:1; }
    .iph-tx-name { font-size:.8rem; font-weight:700; }
    .iph-tx-date { font-size:.66rem; color:rgba(255,255,255,.3); }
    .iph-tx-amt { font-size:.88rem; font-weight:800; }

    /* Send screen */
    .iph-to-label { font-size:.72rem; color:rgba(255,255,255,.3); }
    .iph-recipient {
      display:flex; align-items:center; gap:10px;
      background:rgba(0,174,239,.07); border:1px solid rgba(0,174,239,.2);
      border-radius:16px; padding:12px;
    }
    .iph-rec-av {
      width:40px; height:40px; border-radius:50%;
      display:flex; align-items:center; justify-content:center; font-weight:800; flex-shrink:0;
    }
    .iph-rec-name { font-size:.88rem; font-weight:800; }
    .iph-rec-user { font-size:.68rem; color:rgba(255,255,255,.3); }
    .iph-rec-check { color:#00C896; font-size:1.1rem; margin-left:auto; }
    .iph-amount-card {
      background:rgba(2,11,45,.7); border:1.5px solid rgba(0,174,239,.25);
      border-radius:18px; padding:16px; text-align:center;
    }
    .iph-amt-label { font-size:.68rem; color:rgba(255,255,255,.3); margin-bottom:4px; }
    .iph-amt-big { font-size:2.6rem; font-weight:900; color:#00AEEF; line-height:1; }
    .iph-amt-htg { font-size:.7rem; color:rgba(255,255,255,.25); margin-top:4px; }
    .iph-fee-row {
      display:flex; justify-content:space-between; align-items:center;
      font-size:.8rem; padding:7px 0;
      border-bottom:1px solid rgba(255,255,255,.05); color:rgba(255,255,255,.4);
    }
    .iph-send-btn {
      background:linear-gradient(135deg,#1055CC,#00AEEF);
      border-radius:50px; padding:14px; text-align:center;
      font-size:.9rem; font-weight:800; color:#fff; margin-top:auto; cursor:pointer;
    }

    /* Receive screen */
    .iph-qr-wrap {
      width:140px; height:140px; background:#F0F6FF; border-radius:16px;
      padding:10px; margin:0 auto 10px;
    }
    .iph-share-btn {
