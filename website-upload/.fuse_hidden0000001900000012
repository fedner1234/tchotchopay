<style>
:root{
  --bg:#07091a;--panel:#0d1120;--card:#111827;--border:#1e2a40;
  --cyan:#00e5ff;--cyan2:#00b4cc;--green:#00e676;--red:#ff5252;--orange:#F7B731;--yellow:#ffd740;
  --txt:#e8eaf6;--muted:#8899aa;
}
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0;}
body{font-family:'Segoe UI',system-ui,sans-serif;background:var(--bg);color:var(--txt);min-height:100vh;}

/* ── TOP BAR ── */
.topnav{
  position:fixed;top:0;left:0;right:0;z-index:100;
  background:rgba(7,9,26,.95);backdrop-filter:blur(12px);
  border-bottom:1px solid var(--border);
  padding:14px 28px;display:flex;align-items:center;gap:14px;
}
.nav-logo{display:flex;align-items:center;gap:10px;text-decoration:none;}
.nav-logo-box{width:32px;height:32px;border-radius:8px;background:linear-gradient(135deg,#0a1f6e,var(--cyan));display:flex;align-items:center;justify-content:center;font-weight:900;color:#fff;font-size:14px;}
.nav-brand{font-size:15px;font-weight:700;color:var(--txt);}
.nav-brand em{color:var(--cyan);font-style:normal;}
.nav-back{margin-left:auto;display:flex;align-items:center;gap:6px;color:var(--muted);text-decoration:none;font-size:13px;transition:.15s;}
.nav-back:hover{color:var(--txt);}

/* ── LAYOUT ── */
.page-wrap{min-height:100vh;padding:80px 0 60px;display:flex;align-items:flex-start;justify-content:center;}
.page-inner{width:100%;max-width:680px;padding:0 20px;}

/* ── PROGRESS ── */
.progress-wrap{margin:32px 0 28px;}
.progress-label{display:flex;justify-content:space-between;align-items:center;margin-bottom:10px;}
.progress-label-left{font-size:12px;color:var(--muted);}
.progress-label-right{font-size:12px;font-weight:700;color:var(--cyan);}
.progress-bar{height:4px;background:var(--border);border-radius:2px;}
.progress-fill{height:100%;background:linear-gradient(to right,var(--cyan2),var(--cyan));border-radius:2px;transition:.4s;}
.steps-row{display:flex;gap:0;margin-top:10px;}
.step-dot{flex:1;display:flex;flex-direction:column;align-items:center;gap:4px;}
.step-dot-circle{width:22px;height:22px;border-radius:50%;border:2px solid var(--border);background:var(--bg);display:flex;align-items:center;justify-content:center;font-size:9px;font-weight:700;color:var(--muted);transition:.3s;}
.step-dot-circle.done{background:var(--cyan);border-color:var(--cyan);color:#000;}
.step-dot-circle.active{border-color:var(--cyan);color:var(--cyan);}
.step-dot-lbl{font-size:9px;color:var(--muted);text-align:center;}

/* ── CARD ── */
.form-card{background:var(--panel);border:1px solid var(--border);border-radius:16px;padding:32px;margin-bottom:20px;}
.step-icon{width:52px;height:52px;border-radius:14px;background:linear-gradient(135deg,rgba(247,183,49,.2),rgba(255,107,107,.2));border:1px solid rgba(247,183,49,.3);display:flex;align-items:center;justify-content:center;font-size:24px;margin-bottom:18px;}
.step-title{font-size:20px;font-weight:800;margin-bottom:6px;}
.step-sub{font-size:13px;color:var(--muted);margin-bottom:24px;line-height:1.6;}

/* ── FORM ELEMENTS ── */
.form-group{margin-bottom:18px;}
.form-row-2{display:grid;grid-template-columns:1fr 1fr;gap:14px;}
label{font-size:12px;color:var(--muted);display:block;margin-bottom:6px;font-weight:500;}
label span.req{color:var(--orange);}
input,select,textarea{
  width:100%;padding:11px 14px;background:#ffffff08;
  border:1px solid var(--border);border-radius:9px;
  color:var(--txt);font-size:14px;outline:none;font-family:inherit;
  transition:.2s;
}
input:focus,select:focus,textarea:focus{border-color:var(--cyan);background:#00e5ff05;}
input::placeholder,textarea::placeholder{color:var(--muted);}
select option{background:var(--panel);}
textarea{resize:vertical;min-height:90px;}
.input-with-icon{position:relative;}
.input-with-icon i{position:absolute;left:12px;top:50%;transform:translateY(-50%);color:var(--muted);font-size:16px;pointer-events:none;}
.input-with-icon input{padding-left:38px;}

/* ── CATEGORY GRID ── */
.cat-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:8px;margin-top:6px;}
.cat-btn{
  padding:10px 8px;border-radius:10px;background:#ffffff06;
  border:1px solid var(--border);cursor:pointer;text-align:center;
  font-size:12px;font-weight:500;color:var(--muted);transition:.15s;
}
.cat-btn:hover,.cat-btn.on{background:rgba(247,183,49,.1);border-color:rgba(247,183,49,.5);color:var(--orange);}
.cat-btn span{display:block;font-size:20px;margin-bottom:4px;}

/* ── UPLOAD ZONE ── */
.upload-zone{
  border:2px dashed var(--border);border-radius:10px;padding:24px;
  text-align:center;cursor:pointer;transition:.2s;margin-top:6px;
}
.upload-zone:hover,.upload-zone.has-file{border-color:var(--orange);background:rgba(247,183,49,.04);}
.upload-zone i{font-size:28px;color:var(--muted);display:block;margin-bottom:8px;}
.upload-zone.has-file i{color:var(--orange);}
.upload-label{font-size:13px;color:var(--muted);}
.upload-zone.has-file .upload-label{color:var(--orange);font-weight:600;}
.upload-sub{font-size:11px;color:var(--muted);margin-top:4px;}

/* ── PAYOUT METHODS ── */
.method-card{
  display:flex;align-items:center;gap:12px;padding:12px 14px;
  background:#ffffff06;border:1px solid var(--border);border-radius:10px;
  cursor:pointer;transition:.15s;margin-bottom:8px;
}
.method-card:hover,.method-card.on{border-color:var(--orange);background:rgba(247,183,49,.07);}
.method-radio{width:16px;height:16px;border-radius:50%;border:2px solid var(--muted);flex-shrink:0;position:relative;transition:.15s;}
.method-radio::after{content:'';position:absolute;inset:2px;border-radius:50%;background:var(--orange);opacity:0;transition:.15s;}
.method-card.on .method-radio{border-color:var(--orange);}
.method-card.on .method-radio::after{opacity:1;}
.method-icon{font-size:20px;flex-shrink:0;}
.method-info{flex:1;}
.method-name{font-size:13px;font-weight:600;}
.method-sub{font-size:11px;color:var(--muted);}
.method-extra{margin-top:10px;display:none;}
.method-extra.show{display:block;}

/* ── REVIEW BOX ── */
.review-section{margin-bottom:16px;}
.review-title{font-size:11px;color:var(--muted);text-transform:uppercase;letter-spacing:.08em;font-weight:700;margin-bottom:8px;}
.review-row{display:flex;justify-content:space-between;padding:8px 0;border-bottom:1px solid var(--border);font-size:13px;}
.review-row:last-child{border-bottom:none;}
.review-val{font-weight:600;text-align:right;}

/* ── TERMS ── */
.terms-box{
  background:#ffffff05;border:1px solid var(--border);border-radius:10px;
  padding:14px;font-size:12px;color:var(--muted);max-height:140px;overflow-y:auto;line-height:1.7;margin-bottom:14px;
}
.checkbox-row{display:flex;align-items:flex-start;gap:10px;margin-bottom:10px;cursor:pointer;}
.checkbox-row input[type=checkbox]{width:16px;height:16px;margin-top:1px;accent-color:var(--orange);flex-shrink:0;}
.checkbox-row span{font-size:12px;color:var(--muted);line-height:1.5;}

/* ── ACTIONS ── */
.form-actions{display:flex;gap:10px;margin-top:8px;}
.btn{display:inline-flex;align-items:center;gap:7px;padding:12px 22px;border-radius:10px;font-size:14px;font-weight:700;cursor:pointer;border:none;transition:.15s;font-family:inherit;}
.btn-primary{background:linear-gradient(135deg,#F7B731,#ff6b6b);color:#fff;}
.btn-primary:hover{opacity:.88;}
.btn-back{background:#ffffff0d;color:var(--txt);border:1px solid var(--border);}
.btn-back:hover{background:#ffffff18;}
.btn-full{width:100%;justify-content:center;}

/* ── SUCCESS ── */
.success-card{background:var(--panel);border:1px solid rgba(0,230,118,.3);border-radius:16px;padding:40px 32px;text-align:center;}
.success-icon{width:72px;height:72px;border-radius:50%;background:linear-gradient(135deg,rgba(247,183,49,.2),rgba(255,107,107,.2));display:flex;align-items:center;justify-content:center;font-size:32px;margin:0 auto 20px;}
.success-title{font-size:22px;font-weight:800;margin-bottom:8px;}
.success-sub{font-size:14px;color:var(--muted);max-width:400px;margin:0 auto 24px;line-height:1.6;}
.success-steps{text-align:left;background:#ffffff05;border-radius:10px;padding:16px;margin-bottom:24px;}
.success-step{display:flex;align-items:flex-start;gap:10px;padding:6px 0;font-size:13px;}
.ss-num{width:20px;height:20px;border-radius:50%;background:rgba(247,183,49,.2);color:var(--orange);font-size:10px;font-weight:700;display:flex;align-items:center;justify-content:center;flex-shrink:0;margin-top:1px;}

/* ── HERO ── */
.signup-hero{
  text-align:center;padding:32px 0 0;
}
.hero-badge{display:inline-flex;align-items:center;gap:7px;background:rgba(247,183,49,.1);border:1px solid rgba(247,183,49,.3);border-radius:50px;padding:5px 16px;font-size:11px;font-weight:700;color:var(--orange);letter-spacing:.05em;text-transform:uppercase;margin-bottom:14px;}
.hero-title{font-size:28px;font-weight:900;line-height:1.2;margin-bottom:10px;}
.hero-title em{color:var(--orange);font-style:normal;}
.hero-sub{font-size:14px;color:var(--muted);max-width:460px;margin:0 auto 8px;line-height:1.6;}
.hero-perks{display:flex;justify-content:center;gap:20px;flex-wrap:wrap;margin-top:16px;padding-bottom:4px;}
.hero-perk{font-size:12px;color:var(--muted);display:flex;align-items:center;gap:5px;}
.hero-perk i{color:var(--orange);font-size:14px;}

::-webkit-scrollbar{width:4px;}
::-webkit-scrollbar-track{background:transparent;}
::-webkit-scrollbar-thumb{background:#ffffff20;border-radius:2px;}
@media(max-width:600px){.form-row-2{grid-template-columns:1fr;}.cat-grid{grid-template-columns:repeat(2,1fr);}.form-card{padding:22px 18px;}}
</style>
