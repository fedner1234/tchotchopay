<body>

<nav class="topnav">
  <a class="nav-logo" href="index.html">
    <div class="nav-logo-box">T</div>
    <span class="nav-brand">Tchotcho<em>Pay</em></span>
  </a>
  <span style="font-size:12px;color:var(--muted);background:rgba(247,183,49,.1);border:1px solid rgba(247,183,49,.3);padding:3px 10px;border-radius:20px;color:var(--orange);font-weight:600;">Merchant Sign-up</span>
  <a class="nav-back" href="index.html#business"><i class="ti ti-arrow-left"></i> Back</a>
</nav>

<div class="page-wrap">
<div class="page-inner">

  <!-- Hero (step 0 only) -->
  <div class="signup-hero" id="hero-block">
    <div class="hero-badge">🏪 Merchant Partner Program</div>
    <h1 class="hero-title">Grow your business<br/>with <em>Tchotcho Pay</em></h1>
    <p class="hero-sub">Accept digital payments, list your products on our Haitian marketplace, and get paid in USDC — within hours.</p>
    <div class="hero-perks">
      <div class="hero-perk"><i class="ti ti-check"></i>$0 setup fee</div>
      <div class="hero-perk"><i class="ti ti-check"></i>1–2% merchant fee only</div>
      <div class="hero-perk"><i class="ti ti-check"></i>Payouts in &lt;2 hours</div>
      <div class="hero-perk"><i class="ti ti-check"></i>QR code payments</div>
    </div>
  </div>

  <!-- Progress -->
  <div class="progress-wrap" id="progress-wrap" style="display:none;">
    <div class="progress-label">
      <span class="progress-label-left" id="step-label">Step 1 of 5</span>
      <span class="progress-label-right" id="step-name">Business Info</span>
    </div>
    <div class="progress-bar"><div class="progress-fill" id="progress-fill" style="width:20%;"></div></div>
    <div class="steps-row" id="steps-row"></div>
  </div>

  <!-- STEP 0: INTRO -->
  <div id="step-0">
    <div class="form-card" style="margin-top:24px;">
      <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-bottom:16px;">
        <div style="background:#ffffff06;border-radius:10px;padding:14px;text-align:center;">
          <div style="font-size:22px;font-weight:800;color:var(--orange);">$0</div>
          <div style="font-size:11px;color:var(--muted);margin-top:3px;">Setup fee</div>
        </div>
        <div style="background:#ffffff06;border-radius:10px;padding:14px;text-align:center;">
          <div style="font-size:22px;font-weight:800;color:var(--orange);">1–2%</div>
          <div style="font-size:11px;color:var(--muted);margin-top:3px;">Per transaction</div>
        </div>
        <div style="background:#ffffff06;border-radius:10px;padding:14px;text-align:center;">
          <div style="font-size:22px;font-weight:800;color:var(--cyan);">&lt;2 hrs</div>
          <div style="font-size:11px;color:var(--muted);margin-top:3px;">Payout speed</div>
        </div>
        <div style="background:#ffffff06;border-radius:10px;padding:14px;text-align:center;">
          <div style="font-size:22px;font-weight:800;color:var(--green);">24/7</div>
          <div style="font-size:11px;color:var(--muted);margin-top:3px;">Always accepting</div>
        </div>
      </div>
      <button class="btn btn-primary btn-full" onclick="startSignup()"><i class="ti ti-arrow-right"></i> Start Application</button>
      <div style="text-align:center;margin-top:12px;font-size:12px;color:var(--muted);">Takes about 5 minutes · You'll need a government-issued ID</div>
    </div>
  </div>

  <!-- STEP 1: BUSINESS INFO -->
  <div id="step-1" style="display:none;">
    <div class="form-card">
      <div class="step-icon">🏪</div>
      <div class="step-title">Tell us about your business</div>
      <div class="step-sub">Basic information about your store or business.</div>

      <div class="form-group">
        <label>Business / Store Name <span class="req">*</span></label>
        <input type="text" id="biz-name" placeholder="e.g. Marché Soleil" />
      </div>

      <div class="form-group">
        <label>Business Category <span class="req">*</span></label>
        <div class="cat-grid" id="cat-grid">
          <div class="cat-btn" onclick="selCat(this,'Food & Grocery')"><span>🛒</span>Food & Grocery</div>
          <div class="cat-btn" onclick="selCat(this,'Restaurant')"><span>🍽️</span>Restaurant</div>
          <div class="cat-btn" onclick="selCat(this,'Electronics')"><span>📱</span>Electronics</div>
          <div class="cat-btn" onclick="selCat(this,'Clothing')"><span>👗</span>Clothing</div>
          <div class="cat-btn" onclick="selCat(this,'Pharmacy')"><span>💊</span>Pharmacy</div>
          <div class="cat-btn" onclick="selCat(this,'Transport')"><span>🚗</span>Transport</div>
          <div class="cat-btn" onclick="selCat(this,'Education')"><span>🎓</span>Education</div>
          <div class="cat-btn" onclick="selCat(this,'Phone Top-ups')"><span>📶</span>Phone Top-ups</div>
          <div class="cat-btn" onclick="selCat(this,'Other')"><span>🏠</span>Other</div>
        </div>
      </div>

      <div class="form-group">
        <label>Business Address in Haiti <span class="req">*</span></label>
        <input type="text" id="biz-addr" placeholder="e.g. Rue des Miracles 12, Pétion-Ville" />
      </div>

      <div class="form-row-2">
        <div class="form-group">
          <label>City / Area</label>
          <select id="biz-city">
            <option>Port-au-Prince</option><option>Pétion-Ville</option><option>Delmas</option>
            <option>Tabarre</option><option>Carrefour</option><option>Cite Soleil</option>
            <option>Cap-Haïtien</option><option>Gonaïves</option><option>Saint-Marc</option><option>Other</option>
          </select>
        </div>
        <div class="form-group">
          <label>Business Phone</label>
          <input type="tel" id="biz-phone" placeholder="+509 3412-8844" />
        </div>
      </div>

      <div class="form-group">
        <label>Business Email (for receipts & alerts)</label>
        <div class="input-with-icon">
          <i class="ti ti-mail"></i>
          <input type="email" id="biz-email" placeholder="store@email.com" />
        </div>
      </div>

      <div class="form-actions">
        <button class="btn btn-primary" style="flex:1;justify-content:center;" onclick="goStep(2)">Continue <i class="ti ti-arrow-right"></i></button>
      </div>
    </div>
  </div>

  <!-- STEP 2: OWNER INFO -->
  <div id="step-2" style="display:none;">
    <div class="form-card">
      <div class="step-icon">👤</div>
      <div class="step-title">Owner information</div>
      <div class="step-sub">We need to verify who is responsible for this business account.</div>

      <div class="form-row-2">
        <div class="form-group">
          <label>First Name <span class="req">*</span></label>
          <input type="text" id="owner-first" placeholder="Jean" />
        </div>
        <div class="form-group">
          <label>Last Name <span class="req">*</span></label>
          <input type="text" id="owner-last" placeholder="Baptiste" />
        </div>
      </div>

      <div class="form-row-2">
        <div class="form-group">
          <label>Date of Birth <span class="req">*</span></label>
          <input type="date" id="owner-dob" />
        </div>
        <div class="form-group">
          <label>Nationality</label>
          <select id="owner-nat">
            <option>Haitian</option><option>American</option><option>Canadian</option>
            <option>French</option><option>Other</option>
          </select>
        </div>
      </div>

      <div class="form-group">
        <label>Personal Phone Number <span class="req">*</span></label>
        <div class="input-with-icon">
          <i class="ti ti-phone"></i>
          <input type="tel" id="owner-phone" placeholder="+509 3412-8844" />
        </div>
      </div>

      <div class="form-group">
        <label>National ID / Passport Number <span class="req">*</span></label>
        <input type="text" id="owner-id" placeholder="Enter your ID number" />
      </div>

      <div class="form-group">
        <label>Home Address</label>
        <input type="text" id="owner-addr" placeholder="Your personal address" />
      </div>

      <div class="form-actions">
        <button class="btn btn-back" onclick="goStep(1)"><i class="ti ti-arrow-left"></i></button>
        <button class="btn btn-primary" style="flex:1;justify-content:center;" onclick="goStep(3)">Continue <i class="ti ti-arrow-right"></i></button>
      </div>
    </div>
  </div>

  <!-- STEP 3: DOCUMENTS -->
  <div id="step-3" style="display:none;">
    <div class="form-card">
      <div class="step-icon">🪪</div>
      <div class="step-title">Upload documents</div>
      <div class="step-sub">Upload a clear photo of your government-issued ID. Business registration is optional but helps speed up approval.</div>

      <div class="form-group">
        <label>ID Document Type <span class="req">*</span></label>
        <select id="doc-type" onchange="updateDocLabel()">
          <option value="national-id">National ID Card (Haiti)</option>
          <option value="passport">Passport</option>
          <option value="drivers-license">Driver's License</option>
          <option value="resident-card">Permanent Resident Card</option>
        </select>
      </div>

      <div class="form-group">
        <label id="doc-front-label">ID Front <span class="req">*</span></label>
        <div class="upload-zone" id="doc-front-zone" onclick="fakeUpload('front')">
          <i class="ti ti-camera" id="front-icon"></i>
          <div class="upload-label" id="front-label">Click to upload front of ID</div>
          <div class="upload-sub">JPG, PNG or PDF · Max 5MB</div>
        </div>
      </div>

      <div class="form-group">
        <label>ID Back <span class="req">*</span></label>
        <div class="upload-zone" id="doc-back-zone" onclick="fakeUpload('back')">
          <i class="ti ti-camera" id="back-icon"></i>
          <div class="upload-label" id="back-label">Click to upload back of ID</div>
          <div class="upload-sub">JPG, PNG or PDF · Max 5MB</div>
        </div>
      </div>

      <div class="form-group">
        <label>Business Registration Certificate <span style="font-size:11px;color:var(--muted);">(optional — speeds up review)</span></label>
        <div class="upload-zone" id="biz-reg-zone" onclick="fakeUpload('biz')">
          <i class="ti ti-file-text" id="biz-icon"></i>
          <div class="upload-label" id="biz-reg-label">Click to upload business certificate</div>
          <div class="upload-sub">Patente, CFPB, or official registration · Max 5MB</div>
        </div>
      </div>

      <div class="form-actions">
        <button class="btn btn-back" onclick="goStep(2)"><i class="ti ti-arrow-left"></i></button>
        <button class="btn btn-primary" style="flex:1;justify-content:center;" onclick="goStep(4)" id="docs-next" disabled>Continue <i class="ti ti-arrow-right"></i></button>
      </div>
    </div>
  </div>

  <!-- STEP 4: PAYOUT -->
  <div id="step-4" style="display:none;">
    <div class="form-card">
      <div class="step-icon">💸</div>
      <div class="step-title">How do you want to get paid?</div>
      <div class="step-sub">Choose where your USDC earnings get sent when you request a payout.</div>

      <div class="method-card on" onclick="selPayout(this,'bank')" id="pay-bank">
        <div class="method-radio"></div>
        <div class="method-icon">🏦</div>
        <div class="method-info">
          <div class="method-name">Local Bank Transfer</div>
          <div class="method-sub">BNC, Sogebank, UNIBANK — 1–2 hours · 1% fee</div>
        </div>
      </div>
      <div class="method-extra show" id="extra-bank">
        <div class="form-row-2" style="margin-bottom:4px;">
          <div class="form-group"><label>Bank Name</label>
            <select><option>BNC</option><option>Sogebank</option><option>UNIBANK</option><option>Capital Bank</option><option>Citibank Haiti</option></select>
          </div>
          <div class="form-group"><label>Account Number</label><input type="text" placeholder="Enter account number"/></div>
        </div>
        <div class="form-group"><label>Account Holder Name</label><input type="text" placeholder="Name on account"/></div>
      </div>

      <div class="method-card" onclick="selPayout(this,'moncash')" id="pay-moncash">
        <div class="method-radio"></div>
        <div class="method-icon">📱</div>
        <div class="method-info">
          <div class="method-name">MonCash</div>
          <div class="method-sub">Instant · 1.5% fee</div>
        </div>
      </div>
      <div class="method-extra" id="extra-moncash">
        <div class="form-group"><label>MonCash Phone Number</label><input type="tel" placeholder="+509 3412-8844"/></div>
      </div>

      <div class="method-card" onclick="selPayout(this,'usdc')" id="pay-usdc">
        <div class="method-radio"></div>
        <div class="method-icon"><i class="ti ti-currency-dollar" style="color:var(--cyan);font-size:18px;"></i></div>
        <div class="method-info">
          <div class="method-name">Keep as USDC</div>
          <div class="method-sub">Stay in your Tchotcho wallet · No fee</div>
        </div>
      </div>
      <div class="method-extra" id="extra-usdc">
        <div style="font-size:12px;color:var(--muted);padding:8px 12px;background:#00e5ff08;border-radius:8px;">
          Earnings stay in your Tchotcho USDC wallet. You can withdraw to HTG anytime via an agent or bank.
        </div>
      </div>

      <div class="form-actions" style="margin-top:8px;">
        <button class="btn btn-back" onclick="goStep(3)"><i class="ti ti-arrow-left"></i></button>
        <button class="btn btn-primary" style="flex:1;justify-content:center;" onclick="goStep(5)">Continue <i class="ti ti-arrow-right"></i></button>
      </div>
    </div>
  </div>

  <!-- STEP 5: REVIEW & SUBMIT -->
  <div id="step-5" style="display:none;">
    <div class="form-card">
      <div class="step-icon">✅</div>
      <div class="step-title">Review & submit</div>
      <div class="step-sub">Check your information before submitting. You can go back to make changes.</div>

      <div class="review-section">
        <div class="review-title">Business</div>
        <div class="review-row"><span style="color:var(--muted);">Store Name</span><span class="review-val" id="rv-biz-name">—</span></div>
        <div class="review-row"><span style="color:var(--muted);">Category</span><span class="review-val" id="rv-cat">—</span></div>
        <div class="review-row"><span style="color:var(--muted);">Address</span><span class="review-val" id="rv-addr">—</span></div>
        <div class="review-row"><span style="color:var(--muted);">Phone</span><span class="review-val" id="rv-phone">—</span></div>
      </div>

      <div class="review-section">
        <div class="review-title">Owner</div>
        <div class="review-row"><span style="color:var(--muted);">Name</span><span class="review-val" id="rv-owner">—</span></div>
        <div class="review-row"><span style="color:var(--muted);">ID Document</span><span class="review-val" id="rv-doc">—</span></div>
        <div class="review-row"><span style="color:var(--muted);">Payout Method</span><span class="review-val" id="rv-payout">—</span></div>
      </div>

      <div class="terms-box">
        <strong>Tchotcho Pay Merchant Agreement</strong><br/><br/>
        By submitting this application, you agree to our merchant terms of service. You confirm that all information provided is accurate and that you authorize Tchotcho Pay to verify your identity and business through third-party KYC providers. Merchant accounts are subject to a 1–2% transaction fee on all payments received. Payouts are processed within 2 business hours of request. Tchotcho Pay reserves the right to suspend merchant accounts found in violation of our acceptable use policy, including fraudulent transactions or chargebacks exceeding 1% of monthly volume.
      </div>

      <label class="checkbox-row">
        <input type="checkbox" id="agree-terms" onchange="updateSubmit()"/>
        <span>I agree to the <a href="#" style="color:var(--orange);">Merchant Terms of Service</a> and <a href="#" style="color:var(--orange);">Privacy Policy</a></span>
      </label>
      <label class="checkbox-row">
        <input type="checkbox" id="agree-kyc" onchange="updateSubmit()"/>
        <span>I authorize Tchotcho Pay to verify my identity and business information</span>
      </label>

      <div class="form-actions">
        <button class="btn btn-back" onclick="goStep(4)"><i class="ti ti-arrow-left"></i></button>
        <button class="btn btn-primary" style="flex:1;justify-content:center;" id="submit-btn" disabled onclick="submitApplication()">
          <i class="ti ti-check"></i> Submit Application
        </button>
      </div>
    </div>
  </div>

  <!-- STEP 6: SUCCESS -->
  <div id="step-6" style="display:none;">
    <div class="success-card" style="margin-top:32px;">
      <div class="success-icon">🎉</div>
      <h2 class="success-title">Application Submitted!</h2>
      <p class="success-sub">Thank you, <strong id="success-name">Merchant</strong>! Your merchant application is under review. We'll notify you within <strong>24–48 hours</strong>.</p>
      <div class="success-steps">
        <div style="font-size:11px;color:var(--muted);text-transform:uppercase;letter-spacing:.08em;font-weight:700;margin-bottom:10px;">What happens next</div>
        <div class="success-step"><div class="ss-num">1</div><span>Our team verifies your ID and business documents (24–48 hrs)</span></div>
        <div class="success-step"><div class="ss-num">2</div><span>You receive an approval email with your merchant credentials</span></div>
        <div class="success-step"><div class="ss-num">3</div><span>Log in to your merchant portal and start accepting payments</span></div>
        <div class="success-step"><div class="ss-num">4</div><span>List your products on the Haitian marketplace</span></div>
      </div>
      <div style="display:flex;gap:10px;justify-content:center;flex-wrap:wrap;">
        <a href="merchant-portal.html" target="_blank" class="btn btn-primary"><i class="ti ti-building-store"></i> Preview Merchant Portal</a>
        <a href="index.html" class="btn btn-back">Back to Home</a>
      </div>
      <div style="margin-top:16px;font-size:12px;color:var(--muted);">Questions? Email <a href="mailto:merchants@tchotchopay.com" style="color:var(--orange);">merchants@tchotchopay.com</a></div>
    </div>
  </div>

</div>
</div>

<script>
const STEPS_META = [
  {label:'Business Info',pct:20},
  {label:'Owner Info',pct:40},
  {label:'Documents',pct:60},
  {label:'Payout',pct:80},
  {label:'Review',pct:100},
];
let currentStep = 0;
let selectedCat = '';
let selectedPayout = 'bank';
let frontUploaded = false, backUploaded = false;

function startSignup() {
  document.getElementById('hero-block').style.display = 'none';
  document.getElementById('step-0').style.display = 'none';
  document.getElementById('progress-wrap').style.display = 'block';
  goStep(1);
}

function goStep(n) {
  // hide all steps
  [1,2,3,4,5,6].forEach(i => {
    const el = document.getElementById('step-'+i);
    if(el) el.style.display = 'none';
  });
  currentStep = n;
  const el = document.getElementById('step-'+n);
  if(el) el.style.display = 'block';

  if(n <= 5) {
    const meta = STEPS_META[n-1];
    document.getElementById('step-label').textContent = 'Step '+n+' of 5';
    document.getElementById('step-name').textContent = meta.label;
    document.getElementById('progress-fill').style.width = meta.pct+'%';
    renderStepDots(n);
  }
  if(n === 5) fillReview();
  window.scrollTo({top:0,behavior:'smooth'});
}

function renderStepDots(active) {
  const names = ['Business','Owner','Docs','Payout','Review'];
  document.getElementById('steps-row').innerHTML = names.map((n,i)=>{
    const num = i+1;
    const cls = num < active ? 'done' : num === active ? 'active' : '';
    return `<div class="step-dot"><div class="step-dot-circle ${cls}">${num < active ? '✓' : num}</div><div class="step-dot-lbl">${n}</div></div>`;
  }).join('');
}

function selCat(el, cat) {
  document.querySelectorAll('.cat-btn').forEach(b=>b.classList.remove('on'));
  el.classList.add('on');
  selectedCat = cat;
}

function selPayout(el, method) {
  document.querySelectorAll('.method-card').forEach(m=>m.classList.remove('on'));
  document.querySelectorAll('.method-extra').forEach(e=>e.classList.remove('show'));
  el.classList.add('on');
  document.getElementById('extra-'+method).classList.add('show');
  selectedPayout = method;
}

function updateDocLabel() {
  const type = document.getElementById('doc-type').value;
  const label = {
    'national-id':'ID Card Front',
    'passport':'Passport Photo Page',
    'drivers-license':'License Front',
    'resident-card':'Card Front'
  }[type];
  document.getElementById('doc-front-label').innerHTML = label+' <span class="req">*</span>';
}

let uploading = {};
function fakeUpload(side) {
  if(uploading[side]) return;
  uploading[side] = true;
  const zone = document.getElementById(side==='front'?'doc-front-zone':side==='back'?'doc-back-zone':'biz-reg-zone');
  const icon = document.getElementById(side+'-icon');
  const lbl  = document.getElementById(side+'-label');
  lbl.textContent = 'Uploading...';
  icon.className = 'ti ti-loader';
  icon.style.animation = 'spin 1s linear infinite';
  setTimeout(()=>{
    zone.classList.add('has-file');
    icon.className = 'ti ti-circle-check';
    icon.style.color = 'var(--orange)';
    icon.style.animation = '';
    lbl.textContent = side==='biz' ? 'Business certificate uploaded ✓' : (side==='front'?'Front':'Back')+' of ID uploaded ✓';
    uploading[side] = false;
    if(side==='front') frontUploaded = true;
    if(side==='back') backUploaded = true;
    if(frontUploaded && backUploaded) document.getElementById('docs-next').removeAttribute('disabled');
  }, 1400);
}

function fillReview() {
  document.getElementById('rv-biz-name').textContent = document.getElementById('biz-name').value || '—';
  document.getElementById('rv-cat').textContent = selectedCat || '—';
  const addr = document.getElementById('biz-addr').value;
  const city = document.getElementById('biz-city').value;
  document.getElementById('rv-addr').textContent = addr ? addr+', '+city : '—';
  document.getElementById('rv-phone').textContent = document.getElementById('biz-phone').value || '—';
  const first = document.getElementById('owner-first').value;
  const last = document.getElementById('owner-last').value;
  document.getElementById('rv-owner').textContent = [first,last].filter(Boolean).join(' ') || '—';
  document.getElementById('rv-doc').textContent = document.getElementById('doc-type').options[document.getElementById('doc-type').selectedIndex].text;
  const methods = {bank:'Bank Transfer',moncash:'MonCash',usdc:'Keep as USDC'};
  document.getElementById('rv-payout').textContent = methods[selectedPayout];
}

function updateSubmit() {
  const ok = document.getElementById('agree-terms').checked && document.getElementById('agree-kyc').checked;
  document.getElementById('submit-btn')[ok?'removeAttribute':'setAttribute']('disabled','true');
}

function submitApplication() {
  const name = document.getElementById('biz-name').value || 'Merchant';
  document.getElementById('success-name').textContent = name;
  document.getElementById('progress-wrap').style.display = 'none';
  goStep(6);
}

// style spin for icon
const style = document.createElement('style');
style.textContent = '@keyframes spin{from{transform:rotate(0)}to{transform:rotate(360deg)}}';
document.head.appendChild(style);
</script>
