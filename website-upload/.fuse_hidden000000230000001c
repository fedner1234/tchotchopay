    null,
    'Account Setup',
    'Phone Verify',
    'ID Upload',
    'Selfie Check',
    'Add Funds',
    'Review',
    'Complete',
  ];
  const TOTAL = 7;

  // ── NAVIGATION ────────────────────────────────────────────────────
  function nextStep(n) {
    // Capture lead when user advances from step 1 (has name + email)
    if(currentStep === 1 && n === 2) {
      const fname = (document.getElementById('fname') || {}).value || '';
      const lname = (document.getElementById('lname') || {}).value || '';
      const email = (document.getElementById('email') || {}).value || '';
      const country = (document.getElementById('country') || {}).value || '';
      if(email) {
        fetch('/', {
          method: 'POST',
          headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
          body: new URLSearchParams({
            'form-name': 'signup-lead',
            'first-name': fname,
            'last-name': lname,
            'email': email,
            'country': country
          }).toString()
        }).catch(() => {});
      }
    }
    document.getElementById('step' + currentStep).classList.remove('active');
    currentStep = n;
    document.getElementById('step' + currentStep).classList.add('active');
    updateProgress();
    window.scrollTo({top:0, behavior:'smooth'});
    if(n === 6) buildReview();
    if(n === 7) buildSuccess();
  }

  function updateProgress() {
    const pct = (currentStep / TOTAL) * 100;
    document.getElementById('prog-fill').style.width = pct + '%';
    document.getElementById('prog-title').textContent = 'Step ' + currentStep + ' of ' + (TOTAL-1);
    document.getElementById('prog-count').textContent = STEPS[currentStep] || '';
    // Dots
    for(let i = 1; i <= TOTAL; i++) {
      const dot = document.getElementById('sdot-' + i);
      if(!dot) continue;
      dot.classList.remove('active','done');
      if(i < currentStep) dot.classList.add('done');
      else if(i === currentStep) dot.classList.add('active');
    }
    // Hide dots and progress on success
    const isSuccess = currentStep === 7;
    document.getElementById('progress-wrap') && (document.getElementById('progress-wrap').style.display = isSuccess ? 'none' : '');
    document.querySelector('.progress-wrap').style.display = isSuccess ? 'none' : '';
  }

  // ── STEP 1 ─────────────────────────────────────────────────────────
  function checkStep1() {
    const ok = v('fname') && v('lname') && v('email') &&
               v('password') && document.getElementById('password').value.length >= 8 &&
               v('country') && document.getElementById('terms-check').checked;
    document.getElementById('btn1').disabled = !ok;
  }

  function togglePw() {
    const inp = document.getElementById('password');
    inp.type = inp.type === 'password' ? 'text' : 'password';
    const eye = document.getElementById('pw-eye');
    eye.className = inp.type === 'password' ? 'ti ti-eye fi right' : 'ti ti-eye-off fi right';
  }

  function updatePwStrength() {
    const pw = document.getElementById('password').value;
    const el = document.getElementById('pw-strength');
    if(!pw) { el.style.display = 'none'; return; }
    el.style.display = 'block';
    let score = 0;
    if(pw.length >= 8) score++;
    if(/[A-Z]/.test(pw)) score++;
    if(/[0-9]/.test(pw)) score++;
    if(/[^A-Za-z0-9]/.test(pw)) score++;
    const labels = ['','Weak','Fair','Good','Strong'];
    const classes = ['','weak','fair','good','strong'];
    document.getElementById('pw-label').textContent = labels[score];
    document.getElementById('pw-label').style.color = ['','var(--red)','var(--gold)','var(--cyan)','var(--green)'][score];
    for(let i = 1; i <= 4; i++) {
      const bar = document.getElementById('pb' + i);
      bar.className = 'pw-bar' + (i <= score ? ' ' + classes[score] : '');
    }
  }

  // ── STEP 2 ─────────────────────────────────────────────────────────
  let otpSent = false;

  function checkStep2Phone() {
    const ph = document.getElementById('phone').value.replace(/\D/g,'');
    document.getElementById('btn2a').disabled = ph.length < 7;
  }

  function sendOTP() {
    const btn = document.getElementById('btn2a');
    btn.disabled = true;
    btn.innerHTML = '<span class="spin"><i class="ti ti-loader"></i></span> Sending…';
    setTimeout(() => {
      btn.innerHTML = 'Resend Code <i class="ti ti-send"></i>';
      document.getElementById('otp-section').style.display = 'block';
      startOTPTimer();
      document.getElementById('otp0').focus();
      showToast('Code sent! Check your SMS.');
      otpSent = true;
      btn.disabled = false;
    }, 1200);
  }

  function resendOTP() {
    for(let i = 0; i < 6; i++) {
      const box = document.getElementById('otp' + i);
      box.value = '';
      box.classList.remove('filled');
    }
    document.getElementById('btn2b').disabled = true;
    startOTPTimer();
    showToast('New code sent!');
  }

  function startOTPTimer() {
    let secs = 30;
    clearInterval(otpInterval);
    const el = document.getElementById('otp-timer');
    otpInterval = setInterval(() => {
      secs--;
      el.textContent = '0:' + String(secs).padStart(2,'0');
      if(secs <= 0) { clearInterval(otpInterval); el.textContent = ''; }
    }, 1000);
  }

  function otpInput(el, idx) {
    el.value = el.value.replace(/[^0-9]/g,'').slice(-1);
    if(el.value) {
      el.classList.add('filled');
      if(idx < 5) document.getElementById('otp' + (idx+1)).focus();
    } else el.classList.remove('filled');
    checkOTP();
  }

  function otpKey(e, idx) {
    if(e.key === 'Backspace' && !document.getElementById('otp' + idx).value && idx > 0) {
      document.getElementById('otp' + (idx-1)).focus();
    }
  }

  function checkOTP() {
    let full = '';
    for(let i = 0; i < 6; i++) full += document.getElementById('otp' + i).value;
    document.getElementById('btn2b').disabled = full.length < 6;
  }

  function verifyOTP() {
    const btn = document.getElementById('btn2b');
    btn.disabled = true;
    btn.innerHTML = '<span class="spin"><i class="ti ti-loader"></i></span> Verifying…';
    setTimeout(() => {
      // Simulate: any 6-digit code works in demo
      showToast('Phone verified! ✓');
      nextStep(3);
    }, 1000);
  }

  // ── STEP 3 ─────────────────────────────────────────────────────────
  function selectIdType(el, type) {
    document.querySelectorAll('.id-type').forEach(e => e.classList.remove('selected'));
    el.classList.add('selected');
    selectedId = type;
    document.getElementById('id-upload-wrap').style.display = 'block';
    // Passport has no back
    document.getElementById('back-upload-section').style.display = type === 'passport' ? 'none' : 'block';
    backDone = type === 'passport'; // no back needed for passport
    checkStep3();
  }

  function handleFile(input, side) {
    if(!input.files[0]) return;
    const name = input.files[0].name;
    if(side === 'front') {
      document.getElementById('front-empty').style.display = 'none';
      document.getElementById('front-done').style.display = 'block';
      document.getElementById('front-name').textContent = name;
      document.getElementById('upload-front').classList.add('done');
      frontDone = true;
    } else {
      document.getElementById('back-empty').style.display = 'none';
      document.getElementById('back-done').style.display = 'block';
      document.getElementById('back-name').textContent = name;
      document.getElementById('upload-back').classList.add('done');
      backDone = true;
    }
    checkStep3();
  }

  function handleDrop(e, side) {
    e.preventDefault();
    document.getElementById('upload-' + side).classList.remove('drag');
    if(e.dataTransfer.files[0]) {
      const dt = new DataTransfer();
      dt.items.add(e.dataTransfer.files[0]);
      const input = document.querySelector('#upload-' + side + ' input');
      input.files = dt.files;
      handleFile(input, side);
    }
  }

  function checkStep3() {
    document.getElementById('btn3').disabled = !(selectedId && frontDone && backDone);
  }

  // ── STEP 4 ─────────────────────────────────────────────────────────
  function triggerSelfie() {
    document.getElementById('selfie-input').click();
  }

  function handleSelfie(input) {
    if(!input.files[0]) return;
    document.getElementById('selfie-empty').style.display = 'none';
    document.getElementById('selfie-done').style.display = 'block';
    document.getElementById('selfie-zone').classList.add('done');
    selfieDone = true;
    document.getElementById('btn4').disabled = false;
  }

  // ── STEP 5 ─────────────────────────────────────────────────────────
  function selectFund(el, method) {
    document.querySelectorAll('.fund-opt').forEach(e => e.classList.remove('selected'));
    el.classList.add('selected');
    fundMethod = method;
    updateFundSummary();
  }

  function selectAmt(el, amt) {
    document.querySelectorAll('.fund-amt').forEach(e => e.classList.remove('selected'));
    el.classList.add('selected');
    fundAmt = parseFloat(amt);
    document.getElementById('fund-amount').value = '';
    updateFundSummary();
  }

  function checkFundAmt() {
    const val = parseFloat(document.getElementById('fund-amount').value);
    if(val > 0) {
      document.querySelectorAll('.fund-amt').forEach(e => e.classList.remove('selected'));
      fundAmt = val;
    }
    updateFundSummary();
  }

  function updateFundSummary() {
    const summary = document.getElementById('fund-summary');
    if(!fundMethod || !fundAmt) { summary.style.display = 'none'; document.getElementById('btn5').disabled = true; return; }
    const fees = {bank:0, debit:.02, credit:.03, wire:0};
    const fee = fees[fundMethod] || 0;
    const feeAmt = (fundAmt * fee).toFixed(2);
    const total = (fundAmt + fundAmt * fee).toFixed(2);
    const htg = (fundAmt * 130.5).toLocaleString('en-US',{maximumFractionDigits:0});
    const methodNames = {bank:'Bank ACH',debit:'Debit Card',credit:'Credit Card',wire:'Wire Transfer'};
    document.getElementById('fund-summary-text').innerHTML =
      `<strong>$${total}</strong> via ${methodNames[fundMethod]} → <strong>${fundAmt.toFixed(2)} USDC</strong> · ≈ ${htg} HTG${feeAmt>0 ? ` · Fee: $${feeAmt}` : ' · Free'}`;
    summary.style.display = 'flex';
    document.getElementById('btn5').disabled = false;
  }

  // ── STEP 6 ─────────────────────────────────────────────────────────
  function buildReview() {
    const fname = v('fname') ? document.getElementById('fname').value : 'User';
    const lname = v('lname') ? document.getElementById('lname').value : '';
    const emailVal = v('email') ? document.getElementById('email').value : '—';
    const phone = v('phone') ? document.getElementById('phone').value : '—';
    const country = v('country') ? document.getElementById('country').value : '—';
    const idMap = {passport:'Passport',driver:"Driver's License",national:'National ID'};
    const idLabel = selectedId ? idMap[selectedId] : 'None';
    const amtLabel = fundAmt ? `$${fundAmt.toFixed(2)} USDC` : 'Skip';
    const methodMap = {bank:'Bank ACH',debit:'Debit Card',credit:'Credit Card',wire:'Wire'};

    document.getElementById('review-status').innerHTML = `
      <div class="kyc-row"><i class="ti ti-user ok"></i><span>Name: <strong>${fname} ${lname}</strong></span><span class="kyc-badge done">✓</span></div>
      <div class="kyc-row"><i class="ti ti-mail ok"></i><span>Email: <strong>${emailVal}</strong></span><span class="kyc-badge done">✓</span></div>
      <div class="kyc-row"><i class="ti ti-device-mobile ok"></i><span>Phone: <strong>${phone}</strong></span><span class="kyc-badge done">Verified</span></div>
      <div class="kyc-row"><i class="ti ti-globe ok"></i><span>Country: <strong>${country}</strong></span><span class="kyc-badge done">✓</span></div>
      <div class="kyc-row"><i class="ti ti-id-badge ok"></i><span>ID: <strong>${idLabel}</strong> uploaded</span><span class="kyc-badge review">Review</span></div>
      <div class="kyc-row"><i class="ti ti-camera ok"></i><span>Selfie: <strong>Captured</strong></span><span class="kyc-badge review">Review</span></div>
      <div class="kyc-row"><i class="ti ti-wallet ok"></i><span>Initial deposit: <strong>${amtLabel}</strong>${fundMethod ? ' via ' + (methodMap[fundMethod]||'') : ''}</span><span class="kyc-badge done">✓</span></div>`;
  }

  function checkStep6() {
    document.getElementById('btn6').disabled = !document.getElementById('confirm-check').checked;
  }

  function submitKYC() {
    const btn = document.getElementById('btn6');
    btn.disabled = true;
    btn.innerHTML = '<span class="spin"><i class="ti ti-loader"></i></span> Activating Wallet…';
    setTimeout(() => { nextStep(7); }, 2200);
  }

  // ── STEP 7 ─────────────────────────────────────────────────────────
  function buildSuccess() {
    const fname = v('fname') ? document.getElementById('fname').value : 'User';
    const lname = v('lname') ? document.getElementById('lname').value : '';
    document.getElementById('wc-name').textContent = fname + ' ' + lname;
    const bal = fundAmt || 0;
    document.getElementById('wc-balance').textContent = '$' + bal.toFixed(2) + ' USDC';
    document.getElementById('wc-htg').textContent = '≈ ' + (bal * 130.5).toLocaleString('en-US',{maximumFractionDigits:0}) + ' HTG at today\'s rate';
    // Random-ish wallet address for demo
    const addr = '0x' + Math.random().toString(16).slice(2,6).toUpperCase() + '…' + Math.random().toString(16).slice(2,6).toUpperCase();
    document.getElementById('wc-addr').textContent = addr + ' · Base Network';
  }

  // ── UTILS ─────────────────────────────────────────────────────────
  function v(id) {
    const el = document.getElementById(id);
    return el && el.value && el.value.trim().length > 0;
  }

  function showToast(msg) {
    const t = document.getElementById('toast');
    t.textContent = msg;
    t.classList.add('show');
    setTimeout(() => t.classList.remove('show'), 2600);
  }

  // Spin keyframe
  const s = document.createElement('style');
  s.textContent = '@keyframes spin{to{transform:rotate(360deg)}}';
  document.head.appendChild(s);
</script>
