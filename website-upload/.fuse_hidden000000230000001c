<body>

<!-- Hidden form for Netlify to detect at deploy time -->
<form name="signup-lead" data-netlify="true" netlify-honeypot="bot-field" hidden>
  <input type="hidden" name="form-name" value="signup-lead"/>
  <input type="text" name="first-name"/>
  <input type="text" name="last-name"/>
  <input type="email" name="email"/>
  <input type="text" name="country"/>
</form>

<!-- Mobile top bar -->
<div class="mobile-bar">
  <div style="width:32px;height:32px;border-radius:8px;background:linear-gradient(135deg,#1055CC,#00AEEF);display:flex;align-items:center;justify-content:center;font-weight:900;font-size:.9rem;">T</div>
  <div class="mb-brand">Tchotcho<em>Pay</em></div>
  <a href="index.html" style="margin-left:auto;color:var(--gray);font-size:.8rem;text-decoration:none;">← Back</a>
</div>

<div class="split">

  <!-- ── LEFT PANEL ── -->
  <div class="left-panel">
    <div>
      <div class="lp-brand">
        <div class="lp-logo">T</div>
        <div class="lp-name">Tchotcho<em>Pay</em></div>
      </div>
