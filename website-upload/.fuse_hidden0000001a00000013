<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Tchotcho Pay — Follow Us on Social Media</title>
  <meta name="description" content="Follow Tchotcho Pay on Instagram, Facebook, X, and TikTok. Send money to Haiti with USDC — join our community."/>
  <link rel="canonical" href="https://tchotchopay.com/social.html"/>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@latest/tabler-icons.min.css"/>
  <style>
    *,*::before,*::after{box-sizing:border-box;margin:0;padding:0;}
    :root{
      --navy:#020B2D;--blue:#0A1F6E;--mid:#1055CC;
      --cyan:#00AEEF;--light:#7FD4F7;--gray:#8FA8CC;
      --white:#F0F6FF;--green:#00C896;--gold:#F7B731;--red:#FF4C6A;
    }
    html{scroll-behavior:smooth;}
    body{background:var(--navy);color:var(--white);font-family:'Segoe UI',system-ui,sans-serif;min-height:100vh;display:flex;flex-direction:column;align-items:center;}

    /* NAV */
    nav{position:fixed;top:0;left:0;right:0;z-index:9999;display:flex;align-items:center;padding:14px 32px;background:rgba(2,11,45,.96);backdrop-filter:blur(12px);border-bottom:1px solid rgba(0,174,239,.15);gap:12px;}
    .nav-brand{display:flex;align-items:center;gap:10px;text-decoration:none;color:var(--white);}
    .nav-logo{width:34px;height:34px;border-radius:8px;overflow:hidden;flex-shrink:0;background:linear-gradient(135deg,#0A1F6E,#00AEEF);}
    .nav-logo img{width:100%;height:100%;object-fit:cover;}
    .nav-name{font-weight:700;font-size:1rem;}
    .nav-name em{color:var(--cyan);font-style:normal;}
    .nav-back{margin-left:auto;color:var(--gray);text-decoration:none;font-size:.85rem;padding:7px 16px;border-radius:50px;border:1px solid rgba(0,174,239,.2);transition:.2s;}
    .nav-back:hover{color:var(--white);border-color:var(--cyan);}

    /* HERO */
    .hero{padding:120px 24px 48px;text-align:center;width:100%;max-width:680px;}
    .badge{display:inline-flex;align-items:center;gap:6px;background:rgba(0,174,239,.1);border:1px solid rgba(0,174,239,.25);border-radius:50px;padding:6px 16px;font-size:.8rem;color:var(--cyan);font-weight:600;margin-bottom:20px;}
    .hero h1{font-size:clamp(2rem,5vw,3rem);font-weight:800;line-height:1.2;margin-bottom:14px;}
    .hero h1 em{color:var(--cyan);font-style:normal;}
    .hero p{color:var(--gray);font-size:1.05rem;line-height:1.6;max-width:480px;margin:0 auto;}

    /* SOCIAL CARDS */
    .social-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:20px;width:100%;max-width:680px;padding:0 24px 48px;}

    .social-card{
      background:rgba(255,255,255,.04);
      border:1px solid rgba(0,174,239,.15);
      border-radius:20px;
      padding:28px 24px;
      text-decoration:none;
      color:var(--white);
      display:flex;align-items:center;gap:20px;
      transition:all .25s;
      position:relative;overflow:hidden;
    }
    .social-card::before{content:'';position:absolute;inset:0;opacity:0;transition:.25s;border-radius:20px;}
    .social-card:hover{transform:translateY(-4px);border-color:var(--platform-color);}
    .social-card:hover::before{opacity:1;}
    .social-card:hover .social-icon{transform:scale(1.1);}

    .social-card.instagram{--platform-color:#E1306C;}
    .social-card.instagram:hover{box-shadow:0 12px 40px rgba(225,48,108,.2);}
    .social-card.instagram::before{background:linear-gradient(135deg,rgba(225,48,108,.08),transparent);}

    .social-card.facebook{--platform-color:#1877F2;}
    .social-card.facebook:hover{box-shadow:0 12px 40px rgba(24,119,242,.2);}
    .social-card.facebook::before{background:linear-gradient(135deg,rgba(24,119,242,.08),transparent);}

    .social-card.tiktok{--platform-color:#FF004F;}
    .social-card.tiktok:hover{box-shadow:0 12px 40px rgba(255,0,79,.2);}
    .social-card.tiktok::before{background:linear-gradient(135deg,rgba(255,0,79,.08),transparent);}

    .social-card.twitter{--platform-color:var(--cyan);}
    .social-card.twitter:hover{box-shadow:0 12px 40px rgba(0,174,239,.2);}
    .social-card.twitter::before{background:linear-gradient(135deg,rgba(0,174,239,.08),transparent);}

    .social-icon{
      width:60px;height:60px;border-radius:16px;
      display:flex;align-items:center;justify-content:center;
      font-size:1.8rem;flex-shrink:0;
      transition:.25s;
      background:rgba(255,255,255,.06);
      color:var(--platform-color);
    }
    .social-info{flex:1;}
    .social-platform{font-size:.75rem;font-weight:700;text-transform:uppercase;letter-spacing:.08em;color:var(--gray);margin-bottom:4px;}
    .social-handle{font-size:1.1rem;font-weight:700;color:var(--white);margin-bottom:4px;}
    .social-desc{font-size:.85rem;color:var(--gray);line-height:1.4;}
    .social-arrow{color:var(--gray);font-size:1.1rem;flex-shrink:0;transition:.2s;}
    .social-card:hover .social-arrow{color:var(--platform-color);transform:translateX(4px);}

    /* WAITLIST CTA */
    .cta-section{width:100%;max-width:680px;padding:0 24px 32px;text-align:center;}
    .cta-box{background:linear-gradient(135deg,rgba(16,85,204,.3),rgba(0,174,239,.15));border:1px solid rgba(0,174,239,.3);border-radius:24px;padding:40px 32px;}
    .cta-box h2{font-size:1.6rem;font-weight:800;margin-bottom:10px;}
    .cta-box h2 em{color:var(--cyan);font-style:normal;}
    .cta-box p{color:var(--gray);margin-bottom:24px;}
    .cta-btn{display:inline-flex;align-items:center;gap:8px;background:linear-gradient(135deg,var(--mid),var(--cyan));color:#fff;font-weight:700;font-size:1rem;padding:14px 32px;border-radius:50px;text-decoration:none;transition:.2s;}
    .cta-btn:hover{opacity:.9;transform:translateY(-2px);}

    /* FOOTER */
    .page-footer{padding:32px 24px;text-align:center;color:var(--gray);font-size:.82rem;border-top:1px solid rgba(0,174,239,.08);width:100%;}
    .page-footer a{color:var(--gray);text-decoration:none;margin:0 10px;}
    .page-footer a:hover{color:var(--cyan);}
    .footer-social{margin-top:14px;display:flex;gap:14px;justify-content:center;}
    .footer-social a{color:var(--gray);font-size:1.1rem;text-decoration:none;transition:.2s;}
    .footer-social a:hover{color:var(--cyan);}

    @media(max-width:480px){
      nav{padding:12px 16px;}
      .hero{padding:100px 16px 32px;}
      .social-grid{padding:0 16px 32px;grid-template-columns:1fr;}
      .cta-section{padding:0 16px 32px;}
    }
  </style>
