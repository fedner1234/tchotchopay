<!-- Stripe.js — must load from js.stripe.com, never self-host -->
<script src="https://js.stripe.com/v3/"></script>
<script src="lang.js"></script>
<script>
  // ── DATA ──────────────────────────────────────────────────────────
  const AMOUNTS = [
    { usd:5,  htg:652,  data:'500 MB / 30 mins' },
    { usd:10, htg:1305, data:'1 GB / 60 mins' },
    { usd:20, htg:2610, data:'2 GB / 120 mins' },
    { usd:25, htg:3262, data:'3 GB / 180 mins' },
    { usd:35, htg:4567, data:'5 GB / 250 mins' },
    { usd:50, htg:6525, data:'10 GB / Unlimited calls' },
  ];

  const PLANS = [
    { carrier:'digicel', usd:5,  htg:652,  perks:['500 MB data','30 min calls','Valid 7 days'] },
    { carrier:'digicel', usd:10, htg:1305, perks:['1 GB data','60 min calls','Valid 14 days'] },
    { carrier:'digicel', usd:25, htg:3262, perks:['3 GB data','Unlimited SMS','Valid 30 days'] },
    { carrier:'natcom',  usd:5,  htg:652,  perks:['400 MB data','30 min calls','Valid 7 days'] },
    { carrier:'natcom',  usd:10, htg:1305, perks:['1 GB data','60 min calls','Valid 14 days'] },
    { carrier:'natcom',  usd:20, htg:2610, perks:['2 GB data','Unlimited local','Valid 30 days'] },
  ];

  let selectedCarrier = null;
  let selectedAmount  = null;
  let currentStep     = 1;

  // ── RELOADLY OPERATOR IDs (fetched on load) ───────────────────────
  const RELOADLY_FN = '/.netlify/functions/reloadly';
  let operatorIds = { digicel: null, natcom: null };

  async function loadOperators() {
    try {
      const res  = await fetch(RELOADLY_FN, {
        method:  'POST',
        headers: { 'Content-Type': 'application/json' },
        body:    JSON.stringify({ action: 'operators' })
      });
      const ops = await res.json();
      ops.forEach(op => {
        const name = op.name.toLowerCase();
        // Exact match to avoid picking "Bundles" or "Special Bundle" variants
        if (name === 'digicel haiti') operatorIds.digicel = op.id;
        if (name === 'natcom haiti')  operatorIds.natcom  = op.id;
      });
      console.log('Reloadly operators loaded:', operatorIds);
    } catch (e) {
      console.warn('Could not load Reloadly operators:', e.message);
    }
  }
  loadOperators();

  // ── CARRIER SELECT ────────────────────────────────────────────────
  function selectCarrier(name, el) {
    selectedCarrier = name;
    document.querySelectorAll('.carrier-card').forEach(c => c.classList.remove('selected'));
    el.classList.add('selected');
    document.getElementById('btn1').disabled = false;
    // Update phone preview
    const isDigicel = name === 'digicel';
    const logoEl = document.getElementById('ps-carrier-logo');
    logoEl.className = 'ps-carrier-logo ' + name;
    logoEl.textContent = isDigicel ? 'D!' : 'NT';
    document.getElementById('ps-carrier-name').textContent = isDigicel ? 'Digicel Haiti' : 'Natcom Haiti';
  }

  // ── PHONE FORMAT ─────────────────────────────────────────────────
  function formatPhone(el) {
    let v = el.value.replace(/\D/g,'').slice(0,8);
    if (v.length > 4) v = v.slice(0,2)+' '+v.slice(2,4)+' '+v.slice(4);
    else if (v.length > 2) v = v.slice(0,2)+' '+v.slice(2);
    el.value = v;
    document.getElementById('psd-num').textContent = '+509 ' + (el.value || '__ __ ____');
  }

  function validatePhone() {
    const raw = document.getElementById('phone-input').value.replace(/\D/g,'');
    const valid = raw.length === 8;
    document.getElementById('btn2').disabled = !valid;
    document.getElementById('phone-error').classList.toggle('show', raw.length > 0 && !valid);
    return valid;
  }

  // ── AMOUNT SELECT ────────────────────────────────────────────────
  function buildAmounts() {
    const grid = document.getElementById('amount-grid');
    grid.innerHTML = '';
    AMOUNTS.forEach((a,i) => {
      const d = document.createElement('div');
      d.className = 'amount-card';
      d.innerHTML = `<div class="amount-usd">$${a.usd}</div><div class="amount-htg">${a.htg.toLocaleString()} HTG</div><div class="amount-data">${a.data}</div>`;
      d.onclick = () => selectAmount(a, d);
      grid.appendChild(d);
    });
  }

  function selectAmount(a, el) {
    selectedAmount = a;
    document.querySelectorAll('.amount-card').forEach(c => c.classList.remove('selected'));
    el.classList.add('selected');
    document.getElementById('btn3').disabled = false;

    // Update summary
    const box = document.getElementById('summary-box');
    box.style.display = 'block';
    const phone = document.getElementById('phone-input').value;
    document.getElementById('sv-carrier').textContent = selectedCarrier === 'digicel' ? 'Digicel Haiti' : 'Natcom Haiti';
    document.getElementById('sv-number').textContent = '+509 ' + phone;
    document.getElementById('sv-amount').textContent = `${a.htg.toLocaleString()} HTG (${a.data})`;
    const _feeUsd = ((Math.round(a.usd * 0.029 * 100) + 30 + Math.round(a.usd * 0.02 * 100)) / 100).toFixed(2);
    const _totalUsd = (a.usd + parseFloat(_feeUsd)).toFixed(2);
    document.getElementById('sv-fee').textContent  = '$' + _feeUsd;
    document.getElementById('sv-total').textContent = '$' + _totalUsd;

    // Update phone preview
    const _psFee = ((Math.round(a.usd * 0.029 * 100) + 30 + Math.round(a.usd * 0.02 * 100)) / 100).toFixed(2);
    const _psTotal = (a.usd + parseFloat(_psFee)).toFixed(2);
    document.getElementById('ps-fee-val').textContent  = '$' + _psFee;
    document.getElementById('ps-total-val').textContent = '$' + _psTotal + ' USDC';
    document.querySelectorAll('.ps-amt').forEach(pa => {
      pa.classList.toggle('sel', pa.querySelector('.pa-usd').textContent === '$'+a.usd);
    });
  }

  // ── STRIPE INIT ──────────────────────────────────────────────────
  // Replace with your Stripe publishable key from dashboard.stripe.com
  // Test key starts with pk_test_  |  Live key starts with pk_live_
  const STRIPE_PK = 'pk_live_51U0wFAC4eLwVz6CMDQGr4RBg6l9muv0k0ZV3y8ESZSFVuwfPHhz7JPb6VsAwE4kxFvAcyZwDJX15gpJpvFJUSAcx00EqGDVqmI';
  const stripe    = Stripe(STRIPE_PK);
  const elements  = stripe.elements();
  const cardElement = elements.create('card', {
    style: {
      base: {
        color: '#F0F6FF',
        fontSize: '16px',
        fontFamily: "'Segoe UI', system-ui, sans-serif",
        fontSmoothing: 'antialiased',
        '::placeholder': { color: 'rgba(143,168,204,0.45)' },
      },
      invalid: { color: '#FF4C6A', iconColor: '#FF4C6A' },
    },
    hidePostalCode: true,
  });

  // Mount only once DOM is ready; remount guard
  let cardMounted = false;
  function mountCard() {
    if (!cardMounted) {
      cardElement.mount('#card-element');
      cardMounted = true;
      cardElement.on('change', e => {
        const errEl = document.getElementById('card-errors');
        const wrap  = document.getElementById('card-element');
        if (e.error) {
          errEl.textContent = e.error.message;
          errEl.classList.add('show');
          wrap.classList.add('invalid');
        } else {
          errEl.textContent = '';
          errEl.classList.remove('show');
          wrap.classList.remove('invalid');
          if (e.complete) wrap.classList.add('focused');
        }
      });
    }
  }

  // ── STEPS ────────────────────────────────────────────────────────
  function goStep(n) {
    if (n === 3) buildAmounts();
    if (n === 4) {
      mountCard();
      populatePaymentSummary();
    }
    currentStep = n;
    for(let i=1;i<=5;i++) {
      const panel = document.getElementById('panel'+i);
      if (panel) panel.classList.toggle('active', i===n);
      const dot = document.getElementById('dot'+i);
      if (dot) {
        dot.classList.remove('active','done');
        if (i < n) { dot.classList.add('done'); dot.textContent = '✓'; }
        else if (i === n) { dot.classList.add('active'); dot.textContent = i; }
        else dot.textContent = i;
      }
    }
    for(let i=1;i<=4;i++) {
      const line = document.getElementById('line'+i);
      if (line) line.classList.toggle('done', i < n);
    }
  }

  // ── POPULATE PAYMENT SUMMARY ─────────────────────────────────────
  function populatePaymentSummary() {
    if (!selectedAmount) return;
    const phone    = document.getElementById('phone-input').value;
    const carrier  = selectedCarrier === 'digicel' ? 'Digicel Haiti' : 'Natcom Haiti';
    const amt      = selectedAmount.usd;
    const stripeCents   = Math.round(amt * 0.029 * 100) + 30;
    const platformCents = Math.round(amt * 0.02 * 100);
    const feeCents      = stripeCents + platformCents;
    const feeUsd        = (feeCents / 100).toFixed(2);
    const total         = (amt + feeCents / 100).toFixed(2);
    document.getElementById('pay-carrier').textContent = carrier;
    document.getElementById('pay-phone').textContent   = '+509 ' + phone;
    document.getElementById('pay-topup').textContent   = '$' + amt + '.00';
    document.getElementById('pay-fee').textContent     = '$' + feeUsd;
    document.getElementById('pay-total').textContent   = '$' + total;
  }

  // ── PAY & TOP UP ─────────────────────────────────────────────────
  async function doPayment() {
    const btn     = document.getElementById('btn4');
    const errDiv  = document.getElementById('payment-error');
    const nameVal = document.getElementById('name-on-card').value.trim();

    if (!nameVal) {
      errDiv.style.display = 'block';
      errDiv.textContent   = '⚠️ Please enter the name on your card.';
      return;
    }

    btn.disabled    = true;
    btn.innerHTML   = '<i class="ti ti-loader" style="animation:spin 1s linear infinite"></i> Processing payment…';
    errDiv.style.display = 'none';

    const phoneRaw   = document.getElementById('phone-input').value.replace(/\D/g,'');
    const finalOpId  = operatorIds[selectedCarrier] || (selectedCarrier === 'digicel' ? 173 : 174);

    try {
      // 1 — Create PaymentIntent on server
      const piRes = await fetch('/.netlify/functions/stripe-payment', {
        method:  'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          amount:      selectedAmount.usd,
          carrier:     selectedCarrier,
          phoneNumber: phoneRaw,
        })
      });
      const piData = await piRes.json();
      if (!piRes.ok) throw new Error(piData.error || 'Payment setup failed');

      // 2 — Confirm card payment with Stripe.js
      const { paymentIntent, error } = await stripe.confirmCardPayment(piData.clientSecret, {
        payment_method: {
          card: cardElement,
          billing_details: { name: nameVal },
        }
      });
      if (error) throw new Error(error.message);
      if (paymentIntent.status !== 'succeeded') throw new Error('Payment did not complete. Please try again.');

      // 3 — Payment captured — trigger Reloadly top-up
      btn.innerHTML = '<i class="ti ti-loader" style="animation:spin 1s linear infinite"></i> Sending top-up…';

      const topupRes = await fetch(RELOADLY_FN, {
        method:  'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          action:      'topup',
          operatorId:  finalOpId,
          amount:      selectedAmount.usd,
          phoneNumber: phoneRaw,
        })
      });
      const topupData = await topupRes.json();

      if (!topupRes.ok) {
        // Payment taken but top-up failed — show special message with payment ref
        throw new Error(
          'Payment received but the top-up encountered an issue. ' +
          'Please email support@tchotchopay.com with ref: ' + paymentIntent.id
        );
      }

      window._lastTopupTxId  = topupData.transactionId || topupData.id || null;
      window._lastPaymentId  = paymentIntent.id;
      showSuccess();

    } catch (err) {
      btn.disabled  = false;
      btn.innerHTML = '<i class="ti ti-credit-card"></i> <span>Pay Now</span>';
      errDiv.style.display = 'block';
      errDiv.textContent   = '⚠️ ' + err.message;
    }
  }

  function showSuccess() {
    goStep(5);
    const phone   = document.getElementById('phone-input').value;
    const a       = selectedAmount;
    const carrier = selectedCarrier === 'digicel' ? 'Digicel Haiti' : 'Natcom Haiti';
    const now     = new Date().toLocaleTimeString('en-US',{hour:'2-digit',minute:'2-digit'});
    const total   = (a.usd + (Math.round(a.usd * 0.029 * 100) + 30) / 100).toFixed(2);
    document.getElementById('success-detail').innerHTML = `
      <div class="srow"><span class="sl">Carrier</span><span class="sv">${carrier}</span></div>
      <div class="srow"><span class="sl">Phone</span><span class="sv">+509 ${phone}</span></div>
      <div class="srow"><span class="sl">Recharge</span><span class="sv">${a.htg.toLocaleString()} HTG</span></div>
      <div class="srow"><span class="sl">Data / Mins</span><span class="sv">${a.data}</span></div>
      <div class="srow"><span class="sl">Total Paid</span><span class="sv" style="color:var(--cyan)">$${total} USD</span></div>
      <div class="srow"><span class="sl">Delivered</span><span class="sv" style="color:var(--green)">✓ ${now} (seconds)</span></div>
      ${window._lastTopupTxId ? `<div class="srow"><span class="sl">Top-Up Ref</span><span class="sv" style="font-size:0.78rem;color:var(--gray)">${window._lastTopupTxId}</span></div>` : ''}
      ${window._lastPaymentId ? `<div class="srow"><span class="sl">Payment Ref</span><span class="sv" style="font-size:0.78rem;color:var(--gray)">${window._lastPaymentId}</span></div>` : ''}
    `;
  }

  function resetFlow() {
    selectedCarrier = null;
    selectedAmount  = null;
    document.getElementById('phone-input').value     = '';
    document.getElementById('name-on-card').value    = '';
    document.getElementById('psd-num').textContent   = '+509 __ __ ____';
    document.getElementById('btn1').disabled         = true;
    document.getElementById('btn3').disabled         = true;
    document.getElementById('btn3').innerHTML        = '<i class="ti ti-credit-card"></i> <span id="btn3-text">Continue to Payment</span>';
    document.getElementById('payment-error').style.display = 'none';
    document.querySelectorAll('.carrier-card').forEach(c => c.classList.remove('selected'));
    document.getElementById('summary-box').style.display = 'none';
    if (cardMounted) cardElement.clear();
    goStep(1);
  }

  // ── PHONE PREVIEW AMOUNT ─────────────────────────────────────────
  function psSelectAmt(el, usdStr, htgStr) {
    document.querySelectorAll('.ps-amt').forEach(p => p.classList.remove('sel'));
    el.classList.add('sel');
    const amt = parseFloat(usdStr.replace('$',''));
    const fee = ((Math.round(amt * 0.029 * 100) + 30 + Math.round(amt * 0.02 * 100)) / 100).toFixed(2);
    const total = (amt + parseFloat(fee)).toFixed(2);
    document.getElementById('ps-fee-val').textContent  = '$' + fee;
    document.getElementById('ps-total-val').textContent = '$' + total + ' USDC';
  }

  // ── POPULAR PLANS ────────────────────────────────────────────────
  function buildPlans() {
    const grid = document.getElementById('plans-grid');
    grid.innerHTML = '';
    PLANS.forEach(p => {
      const d = document.createElement('div');
      d.className = 'plan-card';
      const cName = p.carrier === 'digicel' ? 'Digicel' : 'Natcom';
      d.innerHTML = `
        <div class="plan-carrier">
          <span class="plan-carrier-badge ${p.carrier}">${cName}</span>
        </div>
        <div class="plan-amount">$${p.usd}</div>
        <div class="plan-htg">${p.htg.toLocaleString()} HTG</div>
        <div class="plan-perks">
          ${p.perks.map(k=>`<div class="plan-perk"><i class="ti ti-check"></i>${k}</div>`).join('')}
        </div>
        <button class="plan-btn" onclick="quickTopUp('${p.carrier}',${p.usd})">Top Up Now</button>
      `;
      grid.appendChild(d);
    });
  }

  function quickTopUp(carrier, usd) {
    // Pre-select carrier and amount, jump to phone step
    const cardEl = document.getElementById('card-' + carrier);
    selectCarrier(carrier, cardEl);
    goStep(2);
    // Store amount to auto-select on step 3
    window._quickUsd = usd;
  }

  // Auto-select plan amount when reaching step 3
  const origBuildAmounts = buildAmounts;
  buildAmounts = function() {
    origBuildAmounts();
    if (window._quickUsd) {
      const a = AMOUNTS.find(x => x.usd === window._quickUsd);
      if (a) {
        const cards = document.querySelectorAll('.amount-card');
        const idx = AMOUNTS.indexOf(a);
        if (cards[idx]) selectAmount(a, cards[idx]);
      }
      window._quickUsd = null;
    }
  };

  // ── SPIN ANIMATION ───────────────────────────────────────────────
  const styleEl = document.createElement('style');
  styleEl.textContent = '@keyframes spin{to{transform:rotate(360deg)}}';
  document.head.appendChild(styleEl);

  // ── INIT ─────────────────────────────────────────────────────────
  buildPlans();
</script>

