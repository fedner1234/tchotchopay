  <style>
    :root {
      --navy:#020B2D; --blue:#0A1F6E; --mid:#1055CC;
      --cyan:#00AEEF; --light:#7FD4F7; --gray:#8FA8CC;
      --white:#F0F6FF; --green:#00C896; --red:#FF4C6A;
      --digicel:#E20613; --natcom:#0057A8;
    }
    *, *::before, *::after { box-sizing:border-box; margin:0; padding:0; }
    body { background:var(--navy); color:var(--white); font-family:'Segoe UI',system-ui,sans-serif; min-height:100vh; }

    /* ── NAV ── */
    nav {
      position:fixed; top:0; left:0; right:0; z-index:9999;
      display:flex; align-items:center; padding:14px 32px;
      background:rgba(2,11,45,0.96); backdrop-filter:blur(12px);
      border-bottom:1px solid rgba(0,174,239,0.2); gap:16px;
    }
    .nav-brand { display:flex; align-items:center; gap:10px; text-decoration:none; color:var(--white); }
    .nav-logo { width:34px; height:34px; border-radius:8px; overflow:hidden; flex-shrink:0; background:linear-gradient(135deg,#0A1F6E,#00AEEF); }
    .nav-logo img { width:100%; height:100%; object-fit:cover; }
    .nav-brand span { font-weight:700; font-size:1rem; }
    .nav-brand em { color:var(--cyan); font-style:normal; }
    .nav-back { margin-left:auto; color:var(--gray); text-decoration:none; font-size:0.85rem; display:flex; align-items:center; gap:6px; transition:color .2s; white-space:nowrap; }
    .nav-back:hover { color:var(--white); }

    /* ── HERO ── */
    .hero {
      padding:120px 24px 48px;
      text-align:center;
      background:radial-gradient(ellipse 80% 50% at 50% 0%, rgba(0,174,239,0.1) 0%, transparent 70%);
    }
    .hero-badge {
      display:inline-flex; align-items:center; gap:8px;
      background:rgba(0,174,239,0.12); border:1px solid rgba(0,174,239,0.3);
      color:var(--cyan); padding:6px 16px; border-radius:50px;
      font-size:0.78rem; font-weight:700; letter-spacing:.07em; text-transform:uppercase; margin-bottom:18px;
    }
    .hero h1 { font-size:clamp(1.8rem,4vw,2.8rem); font-weight:800; line-height:1.15; margin-bottom:12px; }
    .hero h1 em { color:var(--cyan); font-style:normal; }
    .hero p { color:var(--gray); font-size:1rem; max-width:480px; margin:0 auto; }

    /* ── MAIN LAYOUT ── */
    .page-wrap { max-width:960px; margin:0 auto; padding:0 24px 80px; display:grid; grid-template-columns:1fr 360px; gap:32px; align-items:start; }
    @media(max-width:760px) { .page-wrap { grid-template-columns:1fr; } .phone-preview { display:none; } }

    /* ── FLOW CARD ── */
    .flow-card {
      background:linear-gradient(135deg,rgba(10,31,110,0.55),rgba(2,11,45,0.8));
      border:1px solid rgba(0,174,239,0.2); border-radius:24px; padding:36px;
      backdrop-filter:blur(8px);
    }

    /* Step indicator */
    .steps-bar { display:flex; align-items:center; margin-bottom:32px; gap:0; }
    .step-dot {
      width:32px; height:32px; border-radius:50%; border:2px solid rgba(0,174,239,0.3);
      display:flex; align-items:center; justify-content:center;
      font-size:0.78rem; font-weight:800; color:var(--gray); flex-shrink:0;
      transition:all .3s;
    }
    .step-dot.active { border-color:var(--cyan); color:var(--cyan); background:rgba(0,174,239,0.1); }
    .step-dot.done { border-color:var(--green); background:var(--green); color:#000; }
    .step-line { flex:1; height:2px; background:rgba(0,174,239,0.15); transition:background .3s; }
    .step-line.done { background:var(--green); }

    /* Panels */
    .panel { display:none; }
    .panel.active { display:block; }

    .panel-title { font-size:1.15rem; font-weight:800; margin-bottom:6px; }
    .panel-sub { color:var(--gray); font-size:0.88rem; margin-bottom:24px; }

    /* Carrier grid */
    .carrier-grid { display:grid; grid-template-columns:1fr 1fr; gap:14px; margin-bottom:24px; }
    .carrier-card {
      border:2px solid rgba(0,174,239,0.2); border-radius:16px;
      padding:20px 16px; cursor:pointer; text-align:center;
      transition:all .2s; position:relative; overflow:hidden;
      background:rgba(2,11,45,0.5);
    }
    .carrier-card:hover { border-color:rgba(0,174,239,0.5); transform:translateY(-2px); }
    .carrier-card.selected { border-color:var(--cyan); background:rgba(0,174,239,0.08); }
    .carrier-card.selected::after {
      content:'✓'; position:absolute; top:10px; right:12px;
      color:var(--cyan); font-size:1rem; font-weight:800;
    }
    .carrier-logo {
      width:52px; height:52px; border-radius:14px; margin:0 auto 10px;
      display:flex; align-items:center; justify-content:center;
      font-size:1.4rem; font-weight:900; letter-spacing:-1px;
    }
    .carrier-logo.digicel { background:var(--digicel); color:#fff; }
    .carrier-logo.natcom  { background:var(--natcom);  color:#fff; font-size:0.9rem; }
    .carrier-name { font-weight:700; font-size:0.95rem; margin-bottom:4px; }
    .carrier-sub  { color:var(--gray); font-size:0.78rem; }

    /* Input */
    .input-label { font-size:0.78rem; font-weight:700; letter-spacing:.07em; text-transform:uppercase; color:var(--gray); margin-bottom:6px; }
    .phone-row { display:flex; gap:10px; margin-bottom:20px; }
    .country-code {
      background:rgba(2,11,45,0.7); border:1.5px solid rgba(0,174,239,0.25); border-radius:12px;
      color:var(--white); font-size:0.95rem; font-weight:700; padding:14px 14px;
      display:flex; align-items:center; gap:6px; white-space:nowrap; flex-shrink:0;
    }
    .phone-input {
      flex:1; background:rgba(2,11,45,0.7); border:1.5px solid rgba(0,174,239,0.25);
      border-radius:12px; color:var(--white); font-size:1rem; font-weight:600;
      padding:14px 16px; font-family:inherit; outline:none; transition:border-color .2s;
      width:100%;
    }
    .phone-input:focus { border-color:var(--cyan); }
    .phone-input::placeholder { color:rgba(143,168,204,0.4); }

    /* Amount grid */
    .amount-grid { display:grid; grid-template-columns:repeat(3,1fr); gap:10px; margin-bottom:20px; }
    .amount-card {
      border:1.5px solid rgba(0,174,239,0.2); border-radius:14px;
      padding:14px 10px; text-align:center; cursor:pointer;
      background:rgba(2,11,45,0.5); transition:all .2s;
    }
    .amount-card:hover { border-color:rgba(0,174,239,0.5); }
    .amount-card.selected { border-color:var(--cyan); background:rgba(0,174,239,0.08); }
    .amount-usd { font-size:1.2rem; font-weight:800; color:var(--white); }
    .amount-htg { font-size:0.75rem; color:var(--gray); margin-top:2px; }
    .amount-data { font-size:0.72rem; color:var(--cyan); margin-top:3px; }

    /* Summary box */
    .summary-box {
      background:rgba(2,11,45,0.6); border:1px solid rgba(0,174,239,0.15);
      border-radius:16px; padding:20px; margin-bottom:20px;
    }
    .summary-row { display:flex; justify-content:space-between; padding:8px 0; border-bottom:1px solid rgba(0,174,239,0.08); font-size:0.9rem; }
    .summary-row:last-child { border-bottom:none; }
    .summary-row .label { color:var(--gray); }
    .summary-row .val { font-weight:700; }
    .summary-row .val.green { color:var(--green); }
    .summary-row .val.cyan  { color:var(--cyan); }

    /* Wallet balance */
    .wallet-bar {
      display:flex; align-items:center; justify-content:space-between;
      background:rgba(0,200,150,0.08); border:1px solid rgba(0,200,150,0.2);
      border-radius:12px; padding:12px 16px; margin-bottom:20px;
    }
    .wallet-bar .wl { display:flex; align-items:center; gap:8px; font-size:0.88rem; }
    .wallet-bar .wl i { color:var(--green); }
    .wallet-bar .wl-val { font-weight:800; color:var(--green); }

    /* Buttons */
    .btn-primary {
      width:100%; background:linear-gradient(135deg,var(--mid),var(--cyan));
      color:#fff; border:none; border-radius:50px; padding:16px;
      font-size:1rem; font-weight:700; cursor:pointer; font-family:inherit;
      display:flex; align-items:center; justify-content:center; gap:8px;
      transition:opacity .2s, transform .15s;
    }
    .btn-primary:hover { opacity:.9; transform:translateY(-1px); }
    .btn-primary:disabled { opacity:.4; cursor:not-allowed; transform:none; }
    .btn-secondary {
      width:100%; background:none; border:1.5px solid rgba(0,174,239,0.3);
      color:var(--gray); border-radius:50px; padding:13px;
      font-size:0.9rem; font-weight:600; cursor:pointer; font-family:inherit;
      margin-top:10px; transition:all .2s;
    }
    .btn-secondary:hover { border-color:var(--cyan); color:var(--white); }

    /* Success screen */
    .success-wrap { text-align:center; padding:20px 0; }
    .success-icon {
      width:72px; height:72px; border-radius:50%; background:rgba(0,200,150,0.15);
      border:2px solid var(--green); margin:0 auto 20px;
      display:flex; align-items:center; justify-content:center;
      font-size:2rem; animation:popIn .4s ease;
    }
    @keyframes popIn { 0%{transform:scale(0)} 80%{transform:scale(1.1)} 100%{transform:scale(1)} }
    .success-title { font-size:1.4rem; font-weight:800; color:var(--green); margin-bottom:8px; }
    .success-sub { color:var(--gray); font-size:0.9rem; margin-bottom:24px; line-height:1.5; }
    .success-detail {
      background:rgba(0,200,150,0.06); border:1px solid rgba(0,200,150,0.2);
      border-radius:16px; padding:20px; text-align:left; margin-bottom:24px;
    }
    .success-detail .srow { display:flex; justify-content:space-between; padding:7px 0; border-bottom:1px solid rgba(0,174,239,0.07); font-size:0.88rem; }
    .success-detail .srow:last-child { border:none; }
    .success-detail .srow .sl { color:var(--gray); }
    .success-detail .srow .sv { font-weight:700; }
    .confetti-bar { display:flex; justify-content:center; gap:8px; font-size:1.4rem; margin-bottom:12px; }

    /* Phone preview */
    .phone-preview { position:sticky; top:100px; }
    .phone-shell {
      width:260px; margin:0 auto;
      background:linear-gradient(160deg,#0d1f4e,#050e28);
      border:2px solid rgba(0,174,239,0.35); border-radius:40px;
      padding:14px; box-shadow:0 20px 60px rgba(0,0,0,0.5), 0 0 0 1px rgba(0,174,239,0.1);
      position:relative;
    }
    .phone-notch { width:80px; height:22px; background:#000; border-radius:12px; margin:0 auto 10px; }
    .phone-screen {
      background:#0a1428; border-radius:28px; overflow:hidden;
      min-height:480px; position:relative;
    }
    .ps-header {
      background:linear-gradient(135deg,#0A1F6E,#1055CC);
      padding:16px; text-align:center;
    }
    .ps-header .ps-title { font-size:0.85rem; font-weight:700; color:rgba(255,255,255,0.7); margin-bottom:2px; }
    .ps-header .ps-carrier { font-size:1.1rem; font-weight:800; color:#fff; display:flex; align-items:center; justify-content:center; gap:8px; }
    .ps-body { padding:16px; }
    .ps-phone-display { text-align:center; padding:12px; background:rgba(0,174,239,0.06); border-radius:12px; margin-bottom:12px; }
    .ps-phone-display .psd-label { font-size:0.7rem; color:var(--gray); margin-bottom:2px; }
    .ps-phone-display .psd-num { font-size:1.05rem; font-weight:800; color:var(--white); }
    .ps-amounts { display:grid; grid-template-columns:repeat(3,1fr); gap:6px; margin-bottom:12px; }
    .ps-amt {
      border:1.5px solid rgba(0,174,239,0.2); border-radius:10px;
      padding:8px 4px; text-align:center; cursor:pointer; transition:all .2s;
    }
    .ps-amt.sel { border-color:var(--cyan); background:rgba(0,174,239,0.1); }
    .ps-amt .pa-usd { font-size:0.8rem; font-weight:800; }
    .ps-amt .pa-htg { font-size:0.58rem; color:var(--gray); }
    .ps-total {
      background:rgba(0,200,150,0.1); border:1px solid rgba(0,200,150,0.25);
      border-radius:10px; padding:10px 12px; margin-bottom:12px;
      display:flex; justify-content:space-between; align-items:center;
    }
    .ps-total .pt-label { font-size:0.7rem; color:var(--gray); }
    .ps-total .pt-val { font-size:1rem; font-weight:800; color:var(--green); }
    .ps-btn {
      width:100%; background:linear-gradient(135deg,#1055CC,#00AEEF);
      color:#fff; border:none; border-radius:50px; padding:12px;
      font-size:0.85rem; font-weight:700; cursor:pointer; font-family:inherit;
    }
    .ps-carrier-logo {
      width:28px; height:28px; border-radius:8px; display:inline-flex;
      align-items:center; justify-content:center; font-size:0.65rem; font-weight:900;
    }
    .ps-carrier-logo.digicel { background:var(--digicel); color:#fff; }
    .ps-carrier-logo.natcom  { background:var(--natcom);  color:#fff; }

    /* How it works strip */
    .how-strip { margin:0 0 48px; }
    .how-strip h2 { font-size:1.3rem; font-weight:800; margin-bottom:20px; text-align:center; }
    .how-steps { display:flex; gap:0; justify-content:center; flex-wrap:wrap; }
    .how-step { display:flex; align-items:center; gap:12px; padding:0 24px; position:relative; }
    .how-step:not(:last-child)::after { content:'→'; color:var(--cyan); font-size:1.2rem; margin-left:12px; }
    .hs-num { width:40px; height:40px; border-radius:50%; background:rgba(0,174,239,0.12); border:1.5px solid rgba(0,174,239,0.3); display:flex; align-items:center; justify-content:center; font-weight:800; color:var(--cyan); flex-shrink:0; font-size:0.9rem; }
    .hs-text .ht { font-weight:700; font-size:0.9rem; margin-bottom:2px; }
    .hs-text .hs { color:var(--gray); font-size:0.78rem; }

    /* Popular plans */
    .plans-section { margin:0 0 48px; }
    .plans-section h2 { font-size:1.3rem; font-weight:800; margin-bottom:6px; text-align:center; }
    .plans-sub { color:var(--gray); font-size:0.88rem; text-align:center; margin-bottom:24px; }
    .plans-grid { display:grid; grid-template-columns:repeat(auto-fill,minmax(200px,1fr)); gap:14px; }
    .plan-card {
      background:rgba(10,31,110,0.4); border:1px solid rgba(0,174,239,0.18);
      border-radius:16px; padding:18px; cursor:pointer; transition:all .2s;
    }
    .plan-card:hover { border-color:var(--cyan); transform:translateY(-2px); }
    .plan-carrier { display:flex; align-items:center; gap:8px; margin-bottom:10px; }
    .plan-carrier-badge { padding:3px 8px; border-radius:6px; font-size:0.7rem; font-weight:800; }
    .plan-carrier-badge.digicel { background:rgba(226,6,19,0.2); color:#ff6b76; border:1px solid rgba(226,6,19,0.3); }
    .plan-carrier-badge.natcom  { background:rgba(0,87,168,0.2); color:#7eb8ff; border:1px solid rgba(0,87,168,0.3); }
    .plan-amount { font-size:1.5rem; font-weight:900; margin-bottom:4px; }
    .plan-htg { font-size:0.8rem; color:var(--gray); margin-bottom:8px; }
    .plan-perks { display:flex; flex-direction:column; gap:4px; }
    .plan-perk { font-size:0.75rem; color:var(--light); display:flex; align-items:center; gap:6px; }
    .plan-perk i { color:var(--cyan); font-size:0.8rem; }
    .plan-btn { width:100%; background:linear-gradient(135deg,var(--mid),var(--cyan)); color:#fff; border:none; border-radius:50px; padding:10px; font-size:0.82rem; font-weight:700; cursor:pointer; font-family:inherit; margin-top:12px; }

    /* Error */
    .field-error { color:var(--red); font-size:0.78rem; margin-top:4px; display:none; }
    .field-error.show { display:block; }

    /* ── PAYMENT PANEL ── */
    .payment-mini-summary {
      background:rgba(2,11,45,0.6); border:1px solid rgba(0,174,239,0.15);
      border-radius:14px; padding:16px; margin-bottom:20px;
    }
    .pms-row {
      display:flex; justify-content:space-between; align-items:center;
      padding:7px 0; font-size:0.88rem; border-bottom:1px solid rgba(0,174,239,0.07);
    }
    .pms-row:last-child { border-bottom:none; }
    .pms-row .pms-label { color:var(--gray); }
    .pms-row .pms-val { font-weight:700; color:var(--white); }
    .pms-row.pms-total .pms-label,
    .pms-row.pms-total .pms-val { font-size:1rem; font-weight:800; color:var(--cyan); }

    .stripe-card-wrap {
      background:rgba(2,11,45,0.7); border:1.5px solid rgba(0,174,239,0.25);
      border-radius:12px; padding:14px 16px; margin-bottom:16px;
      transition:border-color .2s;
    }
    .stripe-card-wrap.focused { border-color:var(--cyan); }
    .stripe-card-wrap.invalid { border-color:var(--red); }

    .security-row {
      display:flex; gap:8px; flex-wrap:wrap; margin-bottom:20px;
    }
    .sec-badge {
      display:flex; align-items:center; gap:4px;
      background:rgba(0,174,239,0.06); border:1px solid rgba(0,174,239,0.15);
      color:var(--gray); padding:4px 10px; border-radius:50px;
      font-size:0.72rem; font-weight:600;
    }
    .sec-badge i { color:var(--green); font-size:0.8rem; }

    .payment-error {
      display:none; background:rgba(255,76,106,0.12); border:1px solid rgba(255,76,106,0.35);
      color:var(--red); padding:12px 16px; border-radius:12px;
      margin-top:12px; font-size:0.85rem; line-height:1.4;
    }

    @media(max-width:580px) {
      nav { padding:12px 16px; }
      .flow-card { padding:20px 16px; }
      .carrier-grid { grid-template-columns:1fr 1fr; gap:10px; }
      .amount-grid { grid-template-columns:repeat(3,1fr); gap:8px; }
      .how-step:not(:last-child)::after { content:''; }
      .how-steps { flex-direction:column; align-items:flex-start; padding-left:24px; }
    }
  
    .nav-links{display:flex;gap:6px;margin-left:auto;align-items:center;}
    .nav-link{color:var(--gray,#8FA8CC);text-decoration:none;font-size:.85rem;padding:7px 14px;border-radius:50px;transition:all .2s;}
    .nav-link:hover{color:#F0F6FF;background:rgba(0,174,239,.08);}
    .nav-cta{background:linear-gradient(135deg,#1055CC,#00AEEF);color:#fff!important;font-weight:700;padding:8px 18px;border-radius:50px;}
